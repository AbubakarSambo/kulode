# API URL
# Leave empty for local development (uses Vite proxy)
# For production, set to your Railway API URL
VITE_API_URL=https://api.tarione.com

# PostHog Analytics
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (error monitoring + performance tracing) — leave unset to disable; the app runs fine without it
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# POS order pages/requests sample at the higher rate below; everything else (admin/reporting
# screens) at the lower default. Both 0.0-1.0.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# VITE_SENTRY_HOT_PATH_SAMPLE_RATE=0.5
