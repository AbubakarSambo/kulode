---
import '../styles/global.css'
import RebrandBanner from '../components/RebrandBanner.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'Simple invoicing and financial management for African businesses.',
  ogImage = '/og-default.png',
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? ''
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://us.i.posthog.com'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/fonts/hgi-stroke-rounded.css" />
    <title>{title}</title>

    <!-- PostHog Analytics — loads only after cookie consent -->
    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost }}>
        function initPostHog() {
          if (window.__posthogLoaded) return;
          window.__posthogLoaded = true;
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e.init=function(i,s,a){e._i||(e._i=[]),e._i.push([i,s,a]),e.init.arguments[0]=i},e.config=function(i){e._c||(e._c=[]),e._c.push(i)},o=t.createElement("script"),o.type="text/javascript",o.async=!0,o.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",n=t.getElementsByTagName("script")[0],n.parentNode.insertBefore(o,n))} (document,window.posthog||[]);

          posthog.init(posthogKey, {
            api_host: posthogHost,
            // 'always' = track ALL visitors including anonymous ones.
            // 'identified_only' would silently drop every marketing visitor.
            person_profiles: 'always',
            // Let PostHog handle pageviews automatically
            capture_pageview: true,
            capture_pageleave: true,
          });

          // ── UTM persistence ──────────────────────────────────────────────
          // Capture UTM params from URL and persist them as super properties
          // so every subsequent event in this session carries campaign attribution.
          (function captureUtm() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'ref'];
            var utmProps = {};
            utmKeys.forEach(function(key) {
              var val = params.get(key);
              if (val) utmProps[key] = val;
            });
            if (Object.keys(utmProps).length > 0) {
              posthog.register(utmProps);
            }
            // Set referrer as a person property (persists across sessions)
            if (document.referrer) {
              posthog.people.set_once({ initial_referrer: document.referrer });
            }
          })();

          // ── Cross-domain session stitching ───────────────────────────────
          // When a visitor clicks from tarione.com → app.tarione.com, PostHog
          // loses the session because they are different domains (different cookies).
          // Fix: append ?__phsid=<session_id> to every outbound app link so
          // PostHog on the app side can resume the same session & person profile.
          (function patchCrossDomainLinks() {
            var appDomains = ['app.tarione.com', 'app.kulode.com'];

            function enrichLink(anchor) {
              try {
                var href = anchor.href;
                if (!href) return;
                var url = new URL(href);
                var isAppLink = appDomains.some(function(d) { return url.hostname === d; });
                if (!isAppLink) return;
                var sessionId = posthog.get_session_id();
                if (sessionId) {
                  url.searchParams.set('__phsid', sessionId);
                  anchor.href = url.toString();
                }
              } catch(e) {}
            }

            // Patch all existing links
            document.querySelectorAll('a[href]').forEach(enrichLink);

            // Patch any links added dynamically (e.g. mobile menu)
            document.addEventListener('click', function(e) {
              var anchor = e.target && e.target.closest ? e.target.closest('a[href]') : null;
              if (anchor) enrichLink(anchor);
            }, true);
          })();
        }

        if (localStorage.getItem('tari1_cookie_consent') === 'accepted') {
          initPostHog();
        }
        window.__initPostHog = initPostHog;
      </script>

    )}
  </head>
  <body class="bg-white text-gray-900 antialiased overflow-x-hidden w-full relative">
    <RebrandBanner />
    <slot />

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[9999] bg-white border-t border-slate-200 shadow-2xl px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4" style="display:none">
      <p class="text-sm text-slate-700 max-w-2xl leading-relaxed">
        We use cookies for analytics and advertising. By clicking <strong>Accept</strong>, you consent to our use of cookies as described in our <a href="/privacy" class="underline text-blue-700 hover:text-blue-900">Privacy Policy</a>, including cookies placed by Google for ad measurement.
      </p>
      <div class="flex gap-3 shrink-0">
        <button id="cookie-decline" class="text-xs font-semibold px-4 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer bg-white">
          Decline
        </button>
        <button id="cookie-accept" class="text-xs font-bold px-5 py-2 rounded-lg bg-blue-700 text-white hover:bg-blue-800 transition-colors cursor-pointer shadow-md">
          Accept
        </button>
      </div>
    </div>

    <script is:inline>
      (function() {
        var consent = localStorage.getItem('tari1_cookie_consent');
        if (!consent) {
          var banner = document.getElementById('cookie-banner');
          if (banner) banner.style.display = 'flex';
        }
        document.getElementById('cookie-accept')?.addEventListener('click', function() {
          localStorage.setItem('tari1_cookie_consent', 'accepted');
          document.getElementById('cookie-banner').style.display = 'none';
          if (window.__initPostHog) window.__initPostHog();
        });
        document.getElementById('cookie-decline')?.addEventListener('click', function() {
          localStorage.setItem('tari1_cookie_consent', 'declined');
          document.getElementById('cookie-banner').style.display = 'none';
        });
      })();
    </script>

    <script is:inline>
      // Local network routing fix: dynamically rewrite localhost:5173 links 
      // to the current browser hostname so devices on the same network can access the app.
      (function() {
        if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
          var links = document.querySelectorAll('a');
          for (var i = 0; i < links.length; i++) {
            if (links[i].href && links[i].href.indexOf('localhost:5173') !== -1) {
              links[i].href = links[i].href.replace('localhost', window.location.hostname);
            }
          }
        }
      })();
    </script>
  </body>
</html>
