---
import Layout from '../layouts/Layout.astro'

const appUrl = 'https://app.kulode.com'
const features = [
  {
    title: 'Invoicing',
    description: 'Create and send professional invoices in seconds. Track payment status and send reminders automatically.',
    icon: 'receipt',
  },
  {
    title: 'Online Payments',
    description: 'Accept payments via Paystack. Your clients can pay directly from the invoice link you share.',
    icon: 'credit-card',
  },
  {
    title: 'Expense Tracking',
    description: 'Record and categorise expenses. Stay on top of where your money goes with clear breakdowns.',
    icon: 'wallet',
  },
  {
    title: 'Financial Reports',
    description: 'Revenue, expenses, outstanding invoices — see your business health at a glance with visual reports.',
    icon: 'chart',
  },
  {
    title: 'Client Management',
    description: 'Keep a clean record of all your clients, their invoices, and payment history in one place.',
    icon: 'users',
  },
  {
    title: 'Multi-user Access',
    description: 'Invite your team with role-based access. Admins, accountants, and staff each see what they need.',
    icon: 'shield',
  },
]
---

<Layout title="Kulode — Invoicing & Financial Management for African Businesses">
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight text-gray-900">kulode</a>
      <div class="flex items-center gap-4">
        <a href={`${appUrl}/login`} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Log in</a>
        <a href={`${appUrl}/register`} class="text-sm font-medium bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors">Get started free</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-900 leading-tight">
        Invoicing that gets<br />you paid faster
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Create invoices, accept online payments, track expenses, and see your business finances clearly. Built for small businesses across Africa.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-gray-900 text-white px-8 py-3.5 rounded-lg text-base font-medium hover:bg-gray-800 transition-colors">
          Start for free
        </a>
        <a href="#features" class="w-full sm:w-auto text-center text-gray-600 px-8 py-3.5 rounded-lg text-base font-medium border border-gray-200 hover:border-gray-300 hover:text-gray-900 transition-colors">
          See features
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-20 px-6 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Everything you need to manage your money</h2>
        <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto">Stop juggling spreadsheets. Kulode brings invoicing, payments, expenses, and reports into one simple tool.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-8 border border-gray-100 hover:border-gray-200 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-gray-900 flex items-center justify-center mb-5">
              {feature.icon === 'receipt' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>}
              {feature.icon === 'credit-card' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>}
              {feature.icon === 'wallet' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3" /></svg>}
              {feature.icon === 'chart' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>}
              {feature.icon === 'users' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>}
              {feature.icon === 'shield' && <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>}
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{feature.title}</h3>
            <p class="text-gray-500 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Ready to get started?</h2>
      <p class="mt-4 text-lg text-gray-500">Create your account in under a minute. No credit card required.</p>
      <a href={`${appUrl}/register`} class="mt-8 inline-block bg-gray-900 text-white px-8 py-3.5 rounded-lg text-base font-medium hover:bg-gray-800 transition-colors">
        Get started free
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-sm text-gray-400">&copy; {new Date().getFullYear()} Kulode. All rights reserved.</span>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Privacy</a>
        <a href="/terms" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Terms</a>
      </div>
    </div>
  </footer>
</Layout>
