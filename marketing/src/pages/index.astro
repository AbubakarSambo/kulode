---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
---

<Layout
  title="Tari1 — The POS built for busy Nigerian restaurants"
  description="Take orders tableside, fire tickets to the kitchen instantly, manage your floor, and reconcile every shift — even when the network drops. The POS built for Nigerian restaurants and bars."
>
  <Navbar activePage="features" />

  <main class="hero-gradient">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-16 md:py-32 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="stagger-in">
        <h1 class="text-4xl sm:text-5xl md:text-[72px] leading-[1.1] font-bold text-primary tracking-tight mb-6">The POS that keeps your restaurant running — <span class="text-surface-tint">online or off</span>.</h1>
        <p class="text-base text-text-secondary mb-10 max-w-lg font-medium">Take orders tableside, fire tickets straight to the kitchen, manage your floor in real time, and reconcile every shift down to the naira — even when the network drops. Built for Nigerian restaurants, bars, and quick-service spots.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-primary text-on-primary px-10 py-5 rounded-[12px] text-lg font-bold shadow-2xl shadow-primary/25 active:scale-95 btn-gradient pulse-primary">
            Start for free
          </a>
          <div class="flex items-center gap-3 px-6 py-4">
            <div class="flex -space-x-3">
              <div class="w-8 h-8 rounded-full border-2 border-background bg-surface-container"></div>
              <div class="w-8 h-8 rounded-full border-2 border-background bg-primary-fixed"></div>
              <div class="w-8 h-8 rounded-full border-2 border-background bg-secondary-fixed"></div>
            </div>
            <span class="text-xs text-text-secondary font-medium">Built for Nigerian restaurants & bars</span>
          </div>
        </div>
      </div>
      <!-- ── Hero Right Column ── -->
      <div class="relative w-full flex items-center justify-center py-6 md:py-12 stagger-in hero-visual-col select-none overflow-visible">

        <!-- ── Multi-layer ambient glow (rich depth) ── -->
        <div class="absolute inset-0 pointer-events-none -z-10">
          <!-- Primary blue glow top-right -->
          <div class="absolute top-[-10%] right-[-5%] w-[80%] h-[80%] rounded-full bg-primary/10 blur-[90px]"></div>
          <!-- Warm accent glow bottom-left -->
          <div class="absolute bottom-[5%] left-[-5%] w-[50%] h-[50%] rounded-full bg-surface-tint/8 blur-[70px]"></div>
          <!-- Soft white center bloom -->
          <div class="absolute top-[20%] left-[20%] w-[60%] h-[55%] rounded-full bg-white/60 blur-[50px]"></div>
        </div>

        <!-- ── Premium Portrait Card ── -->
        <div class="relative w-[85%] max-w-[420px] aspect-[4/5] rounded-[32px] overflow-hidden border-2 border-white/80 shadow-[0_24px_48px_rgba(0,55,176,0.12)] bg-white z-10 hover:shadow-[0_32px_64px_rgba(0,55,176,0.18)] transition-all duration-500 float-slow">
          <img
            src="/nigerian_entrepreneur.png"
            alt="Nigerian restaurant owner running Tari1 POS"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <!-- ── Floating Badge 1: Table Status (bottom-left) ── -->
        <div class="absolute bottom-[10%] left-[2%] sm:left-[4%] md:left-[8%] z-20
                    glass-card p-3 sm:p-4 rounded-[20px] sm:rounded-[24px]
                    shadow-[0_12px_32px_rgba(0,55,176,0.12)]
                    border border-white/50
                    max-w-[175px] sm:max-w-[195px]
                    animate-float-card
                    hover:scale-[1.03] transition-transform duration-300">
          <div class="flex items-center gap-2.5 mb-1.5">
            <div class="w-7 h-7 rounded-full bg-primary/15 flex items-center justify-center text-primary shrink-0 relative">
              <i class="hgi-stroke hgi-table-01 text-[16px] z-10"></i>
              <span class="absolute inset-0 rounded-full bg-primary/25 animate-ping"></span>
            </div>
            <div>
              <p class="text-[9px] sm:text-[10px] font-bold text-text-primary">Table 4 · Occupied</p>
              <p class="text-[8px] text-text-secondary">Waiter: Amaka · 32 min</p>
            </div>
          </div>
          <p class="text-base sm:text-lg font-bold text-primary tabular-nums">₦18,500 open</p>
        </div>

        <!-- ── Floating Badge 2: Kitchen Ticket (top-right) ── -->
        <div class="absolute top-[8%] right-[2%] sm:right-[4%] md:right-[8%] z-20
                    glass-card p-2.5 sm:p-3 rounded-[18px] sm:rounded-[20px]
                    shadow-[0_12px_32px_rgba(0,55,176,0.12)]
                    border border-white/50
                    flex items-center gap-2
                    animate-float-card-alt
                    hover:scale-[1.03] transition-transform duration-300">
          <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white shrink-0">
            <i class="hgi-stroke hgi-chef-hat text-[11px]"></i>
          </div>
          <div>
            <p class="text-[9px] sm:text-[10px] font-bold text-text-primary">Kitchen Ticket Fired ✓</p>
            <p class="text-[7px] sm:text-[8px] text-text-secondary">3 items · Table 4 · 0:04s</p>
          </div>
        </div>

        <!-- ── Floating Badge 3: Shift Closed (mid-right) ── -->
        <div class="absolute top-[48%] right-[1%] sm:right-[2%] md:right-[4%] z-20
                    glass-card p-2.5 sm:p-3 rounded-[18px] sm:rounded-[20px]
                    shadow-[0_12px_32px_rgba(0,108,73,0.12)]
                    border border-white/50
                    flex items-center gap-2
                    animate-float-badge-3
                    hover:scale-[1.03] transition-transform duration-300">
          <div class="w-6 h-6 rounded-full bg-success/15 flex items-center justify-center text-success shrink-0">
            <i class="hgi-stroke hgi-file-verified text-[11px]"></i>
          </div>
          <div>
            <p class="text-[9px] sm:text-[10px] font-bold text-text-primary">Shift Closed</p>
            <p class="text-[7px] sm:text-[8px] text-text-secondary">Cash counted · Variance ₦0</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Scroll-down caret indicator -->
    <div class="flex justify-center pb-8 -mt-4 hidden md:flex">
      <div class="flex flex-col items-center gap-1 opacity-40 hover:opacity-80 transition-opacity cursor-pointer" onclick="window.scrollBy({top: window.innerHeight, behavior: 'smooth'})">
        <span class="text-[10px] text-text-secondary uppercase tracking-widest font-bold">Scroll</span>
        <div class="w-4 h-4 border-r-2 border-b-2 border-primary animate-scroll-caret"></div>
      </div>
    </div>

    <!-- Order to Cash Demo Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="stagger-in">
        <span class="inline-block px-3 py-1 rounded-full bg-success/15 text-success text-[10px] font-bold uppercase tracking-wider mb-4">Order to Cash, In Seconds</span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-primary mb-6 leading-tight">Take the order. Fire the kitchen. Get paid.</h2>
        <p class="text-base text-text-secondary mb-8 leading-relaxed">
          Waiters take orders at the table from any phone or tablet. Kitchen staff see tickets the instant they're sent, with a prep timer on every item so nothing goes cold. Cashiers close out with cash, card, transfer, or Paystack — reconciled automatically at shift end.
        </p>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-primary/5 flex items-center justify-center text-primary shrink-0">
              <i class="hgi-stroke hgi-restaurant-01 text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">Tableside Ordering</p>
              <p class="text-xs text-text-secondary">Add items, note modifications per line, and assign a waiter and table before the kitchen even sees it.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center text-success shrink-0">
              <i class="hgi-stroke hgi-chef-hat text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">Live Kitchen Display</p>
              <p class="text-xs text-text-secondary">Every ticket lands on the kitchen screen in real time, with a countdown per item so nothing's late.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-800 shrink-0">
              <i class="hgi-stroke hgi-flash text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">One-Tap Checkout</p>
              <p class="text-xs text-text-secondary">Cash, card, bank transfer, wallet, or Paystack — split however the table wants to pay.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Animated illustration container -->
      <div class="relative flex justify-center items-center py-12 stagger-in">
        <!-- Background decorative pulse circle -->
        <div class="absolute w-[360px] h-[360px] rounded-full bg-primary/5 blur-3xl -z-10 animate-pulse"></div>

        <!-- Cutout Image Card -->
        <div class="relative w-[280px] h-[380px] rounded-[32px] overflow-visible flex items-center justify-center border border-white/60 shadow-2xl bg-white p-2">
          <img src="/person_looking_at_phone.png" alt="Waiter taking an order on a phone" class="w-full h-full object-cover rounded-[24px] filter" />

          <!-- Animation overlays -->

          <!-- Order sent flying card -->
          <div class="absolute -top-6 -left-12 glass-card p-4 rounded-[20px] shadow-lg border border-white/20 max-w-[200px] flex items-center gap-3 animate-float-email">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white shrink-0">
              <i class="hgi-stroke hgi-restaurant-01 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-text-primary leading-tight">Order Sent</p>
              <p class="text-[8px] text-text-secondary leading-tight">to Kitchen 🍳</p>
            </div>
          </div>

          <!-- Kitchen ticket bubble -->
          <div class="absolute top-[35%] -right-16 bg-[#d9fdd3] p-4 rounded-[20px] rounded-tr-none shadow-md border border-[#c2f0b7] max-w-[220px] flex items-start gap-3 animate-slide-whatsapp">
            <div class="w-6 h-6 rounded-full bg-[#0037b0] flex items-center justify-center text-white shrink-0 mt-0.5">
              <i class="hgi-stroke hgi-chef-hat text-xs text-white"></i>
            </div>
            <div>
              <p class="text-[9px] text-[#0037b0] font-bold">Kitchen · Table 4</p>
              <p class="text-[10px] text-text-primary leading-snug mt-1">3 items — Jollof Rice x2, Suya Wrap x1. Timer started.</p>
            </div>
          </div>

          <!-- Checkout animation bubble -->
          <div class="absolute -bottom-6 -left-8 bg-white p-4 rounded-[24px] shadow-2xl border border-outline-variant max-w-[220px] animate-pay-flow">
            <div class="text-center">
              <p class="text-[10px] text-text-secondary">Table 4 Total</p>
              <p class="text-sm font-extrabold text-primary mb-2">₦18,500.00</p>
              <div class="relative inline-block w-full">
                <div class="w-full text-white text-[10px] font-bold py-2.5 rounded-lg flex items-center justify-center gap-1.5 shadow-md shadow-primary/20 relative animate-btn-pay select-none">
                  <span class="pay-text-paynow absolute inset-0 flex items-center justify-center animate-text-paynow">CHARGE TABLE</span>
                  <span class="pay-text-paid absolute inset-0 flex items-center justify-center animate-text-paid opacity-0 text-success bg-success-container font-extrabold">PAID ✓</span>
                </div>
                <!-- Hand clicking cursor -->
                <div class="absolute right-4 bottom-[-16px] w-6 h-6 text-primary animate-cursor-click pointer-events-none">
                  <i class="hgi-stroke hgi-touch-01 text-xl"></i>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="bg-surface-container-low py-32">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-20 stagger-in">
          <h2 class="text-3xl font-extrabold text-primary mb-4">One POS. Every part of service.</h2>
          <p class="text-base text-text-secondary max-w-2xl mx-auto">Stop juggling a paper order pad, a separate kitchen printer, and an end-of-night spreadsheet. Tari1 runs the whole shift from one screen.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Feature 1: Kitchen Display -->
          <div class="feature-card bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_16px_40px_rgba(0,55,176,0.08)] transition-all duration-300 stagger-in flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block px-3 py-1 rounded-full bg-[#ffddb8] text-[#121c28] text-[10px] font-bold uppercase tracking-widest">Kitchen</span>
              </div>
              <div class="feature-icon w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
                <i class="hgi-stroke hgi-chef-hat text-[32px]"></i>
              </div>
              <h3 class="text-lg font-bold text-text-primary mb-4">Live Kitchen Display</h3>
              <p class="text-sm text-text-secondary mb-4">Tickets fire the moment an order's sent. Pending → On It → Pass → Served, with urgent timers so the kitchen never loses track of what's next.</p>
            </div>
          </div>
          <!-- Feature 2: Floor Plan -->
          <div class="feature-card bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] stagger-in">
            <div class="feature-icon w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-table-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Visual Floor Management</h3>
            <p class="text-sm text-text-secondary">See every table's status at a glance — available, occupied, reserved, or needs cleaning — with live totals and assigned waiter, refreshed in real time.</p>
          </div>
          <!-- Feature 3: Offline-First -->
          <div class="feature-card bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] stagger-in">
            <div class="flex items-center justify-between mb-4">
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-[9px] font-bold uppercase tracking-wider">Built For Nigeria</span>
            </div>
            <div class="feature-icon w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-wifi-disconnected-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Works Through Network Drops</h3>
            <p class="text-sm text-text-secondary">Orders keep flowing even when the internet doesn't. Every action queues locally and syncs automatically the moment you're back online.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-32 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <div class="order-2 lg:order-1 relative w-full aspect-video lg:aspect-square flex items-center justify-center min-h-[380px]">
        <!-- Base photo -->
        <div class="w-[85%] rounded-[40px] overflow-hidden shadow-2xl shadow-primary/10 border border-outline-variant/10">
          <img alt="Restaurant staff running Tari1 together" class="w-full h-auto object-cover aspect-video lg:aspect-square" src="/team_collaboration.png">
        </div>
        <!-- Overlapping Reports/Dashboard Screen -->
        <div class="absolute -right-4 -bottom-4 w-[60%] z-20 rounded-2xl border border-outline-variant/20 overflow-hidden shadow-2xl bg-surface-container-lowest transition-all hover:scale-[1.02] duration-300">
          <!-- Mini browser bar -->
          <div class="flex items-center gap-1 px-3 py-2 bg-surface-container border-b border-outline-variant/20">
            <div class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            </div>
          </div>
          <img alt="POS sales dashboard" class="w-full h-auto" src="/uploaded_reports_page.png">
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <span class="bg-surface-container px-4 py-2 rounded-full text-primary text-xs font-bold mb-8 inline-block uppercase tracking-wider">For Teams</span>
        <h2 class="text-4xl font-extrabold text-primary mb-8">Give every role exactly the access they need</h2>
        <p class="text-base text-text-secondary mb-10">From the floor to the till, Tari1 isn't built for one cashier alone. Set up waiters, cashiers, and admins with role-based permissions, track performance per waiter, and reconcile cash at the end of every shift down to the naira.</p>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <i class="hgi-stroke hgi-checkmark-circle-01 text-primary mt-1"></i>
            <div>
              <p class="text-lg font-bold text-text-primary">Role-Based Permissions</p>
              <p class="text-sm text-text-secondary">Waiters take orders, cashiers close tabs, admins manage the menu and see it all — nobody sees more than they need to.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <i class="hgi-stroke hgi-checkmark-circle-01 text-primary mt-1"></i>
            <div>
              <p class="text-lg font-bold text-text-primary">Shift & Cash Reconciliation</p>
              <p class="text-sm text-text-secondary">Open the till with a starting float, close out with a counted-cash breakdown, and catch variances before they become a habit.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Testimonial Section -->
    <section class="bg-primary-container text-on-primary py-32 relative overflow-hidden">
      <!-- Decorative circle -->
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
      <div class="max-w-7xl mx-auto px-container-padding text-center relative z-10">
        <div class="flex justify-center mb-10 text-[#ffffff4d]">
          <i class="hgi-stroke hgi-quote-up text-[64px]"></i>
        </div>
        <blockquote class="testimonial-quote text-3xl md:text-4xl leading-snug mb-12 max-w-4xl mx-auto font-bold">"Tari1 replaced our paper order pads and a separate kitchen printer. Now every ticket, table, and shift close happens from one screen — even when the network drops."</blockquote>
        <div class="flex flex-col items-center">
          <div class="w-16 h-16 rounded-full bg-surface-container mb-4 overflow-hidden border-2 border-white/20">
            <div class="w-full h-full bg-accent-gradient"></div>
          </div>
          <p class="text-lg font-bold text-white">Chioma Eze</p>
          <p class="text-xs opacity-70">Owner, The Grill House, Lekki</p>
          <p class="text-[10px] opacity-50 mt-2">One customer's experience — results vary by business.</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-container-padding">
      <div class="max-w-5xl mx-auto bg-surface-container p-12 md:p-20 rounded-[48px] text-center shadow-xl border border-white/20">
        <h2 class="text-3xl font-extrabold text-primary mb-6">Ready to run a faster floor?</h2>
        <p class="text-base text-text-secondary mb-12 max-w-xl mx-auto">Nigerian restaurants, bars, and quick-service spots trust Tari1 to run their floor, kitchen, and till. No credit card required to start.</p>
        <a href={`${appUrl}/register`} class="inline-block bg-primary text-on-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all btn-gradient">
          Start your 30-day free trial
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Simple Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.animationPlayState = 'running';
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    document.querySelectorAll('.stagger-in').forEach(el => {
        el.style.animationPlayState = 'paused';
        observer.observe(el);
    });

    // Sticky Navbar background shift on scroll
    window.addEventListener('scroll', () => {
        const nav = document.querySelector('nav');
        if (nav) {
            if (window.scrollY > 20) {
                nav.classList.add('shadow-lg');
            } else {
                nav.classList.remove('shadow-lg');
            }
        }
    });

    // ── Hero 3D Card Hover & Parallax Cursor Tracking ──
    const visualCol = document.querySelector('.hero-visual-col');
    const portraitCard = document.querySelector('.hero-visual-col .float-slow');
    const floatingCards = document.querySelectorAll(
      '.animate-float-card, .animate-float-card-alt, .animate-float-badge-3'
    );

    if (visualCol && window.innerWidth > 768) {
        visualCol.addEventListener('mousemove', (e) => {
            const rect = visualCol.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const xc = rect.width / 2;
            const yc = rect.height / 2;
            const dx = (x - xc) / xc; // -1 to 1
            const dy = (y - yc) / yc; // -1 to 1

            if (portraitCard) {
                portraitCard.style.transform = `translate(${dx * -8}px, ${dy * -8}px) rotate(${dx * 1.5}deg) scale(1.005)`;
            }
            floatingCards.forEach(cardEl => {
                cardEl.style.animationPlayState = 'paused';
                cardEl.style.transform = `translate(${dx * 12}px, ${dy * 12}px) scale(1.02)`;
            });
        });

        visualCol.addEventListener('mouseleave', () => {
            if (portraitCard) portraitCard.style.transform = '';
            floatingCards.forEach(cardEl => {
                cardEl.style.animationPlayState = 'running';
                cardEl.style.transform = '';
            });
        });
    }
  </script>

  <style>
    /* ── index.astro specific styles ── */

    /* Scroll-down chevron bounce in hero */
    @keyframes scrollBounce {
      0%, 100% { transform: translateY(0) rotate(45deg); opacity: 0.5; }
      50%       { transform: translateY(6px) rotate(45deg); opacity: 1; }
    }
    .animate-scroll-caret {
      animation: scrollBounce 1.8s ease-in-out infinite;
    }

    /* Feature card subtle lift with icon pop on hover */
    .feature-card {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                  box-shadow 0.3s ease;
    }
    .feature-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 48px rgba(0, 55, 176, 0.11);
    }
    .feature-card:hover .feature-icon {
      transform: scale(1.14) rotate(-4deg);
      background-color: rgba(0, 55, 176, 0.12);
    }
    .feature-icon {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                  background-color 0.3s ease;
    }

    /* Testimonial blockquote subtle underline accent reveal */
    .testimonial-quote {
      position: relative;
    }
    .testimonial-quote::after {
      content: '';
      position: absolute;
      bottom: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 2px;
