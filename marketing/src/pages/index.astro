---
import Layout from '../layouts/Layout.astro'

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
---

<Layout title="Kulode — Invoicing that gets you paid faster">
  <!-- Nav -->
  <nav class="w-full sticky top-0 z-50 bg-background/80 backdrop-blur-xl shadow-[0_12px_32px_rgba(0,55,176,0.08)]">
    <div class="flex justify-between items-center px-container-padding max-w-7xl mx-auto h-[72px]">
      <div class="flex items-center gap-12">
        <a href="/" class="text-[24px] font-extrabold tracking-tighter text-primary">Kulode</a>
        <div class="hidden md:flex items-center gap-8">
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/#features">Features</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/how-it-works">How It Works</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/pricing">Pricing</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/invoicing">Solutions</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/tax-filing">Tax Filing</a>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href={`${appUrl}/login`} class="text-sm font-medium text-text-secondary px-6 py-2 transition-all hover:text-primary active:scale-95">Login</a>
        <a href={`${appUrl}/register`} class="bg-primary text-on-primary px-6 py-3 rounded-[12px] text-sm font-bold shadow-lg shadow-primary/20 hover:shadow-xl transition-all active:scale-95 btn-gradient">Get Started</a>
      </div>
    </div>
  </nav>

  <main class="hero-gradient">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-20 md:py-32 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="stagger-in">
        <h1 class="text-[56px] md:text-[72px] leading-[1.1] font-extrabold text-primary tracking-tight mb-6">Invoicing that gets you <span class="text-surface-tint">paid faster</span> — and keeps you compliant.</h1>
        <p class="text-base text-text-secondary mb-10 max-w-lg">Automate your billing, track payments in real-time, and auto-generate tax schedules. Built specifically for the modern Nigerian business, DNFBP car dealer, and social merchant.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-primary text-on-primary px-10 py-5 rounded-[12px] text-lg font-bold shadow-2xl shadow-primary/25 active:scale-95 btn-gradient pulse-primary">
            Start for free
          </a>
          <div class="flex items-center gap-3 px-6 py-4">
            <div class="flex -space-x-3">
              <div class="w-8 h-8 rounded-full border-2 border-background bg-surface-container"></div>
              <div class="w-8 h-8 rounded-full border-2 border-background bg-primary-fixed"></div>
              <div class="w-8 h-8 rounded-full border-2 border-background bg-secondary-fixed"></div>
            </div>
            <span class="text-xs text-text-secondary font-medium">Joined by 10k+ freelancers</span>
          </div>
        </div>
      </div>
      <div class="relative w-full aspect-square md:aspect-[4/3] flex items-center justify-center min-h-[440px] md:min-h-[520px] stagger-in">
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-surface-container rounded-full blur-3xl opacity-50 -z-10"></div>
        <!-- Base Desktop Dashboard Mockup (z-10) - With Shimmer Gradient Border -->
        <div class="absolute left-0 top-4 w-[82%] z-10 rounded-[20px] p-[1.5px] bg-gradient-to-r from-primary/30 via-primary to-primary/30 animate-shimmer-border shadow-2xl transition-all duration-500 hover:scale-[1.01]">
          <div class="rounded-[19.5px] overflow-hidden bg-surface-container-lowest">
            <div class="flex items-center gap-1.5 px-4 py-3 bg-surface-container border-b border-outline-variant/10 shrink-0">
              <div class="flex gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
              </div>
              <div class="mx-auto bg-surface-container-lowest border border-outline-variant/10 rounded-md px-4 py-0.5 text-[10px] text-text-secondary select-none flex items-center gap-1.5 w-full max-w-[240px] justify-center truncate">
                <i class="hgi-stroke hgi-lock text-[8px] text-success"></i>
                app.kulode.com/invoices/ACM-2026-0020
              </div>
            </div>
            <img alt="Kulode Invoice Detail" class="w-full h-auto object-cover" src="/uploaded_desktop_invoice.png">
          </div>
        </div>
        <!-- Middle Human Layer (z-20) - Transparent Cutout sitting directly on background -->
        <div class="absolute right-[-24px] bottom-0 w-[58%] z-20 pointer-events-none transition-all hover:scale-[1.02] duration-500">
          <img alt="Professional Freelancer" class="w-full h-auto object-contain" src="/lady_cutout.png">
        </div>
        <!-- Foreground Mobile Mockup (z-30) - With Hover-Tilt reaction -->
        <div class="absolute right-[32%] -bottom-4 w-[25%] z-30 rounded-[28px] border-[6px] border-slate-900 overflow-hidden shadow-2xl bg-slate-900 aspect-[9/16] hidden sm:block hover-tilt-mobile cursor-pointer">
          <img alt="Mobile Invoice Details" class="w-full h-full object-cover" src="/uploaded_mobile_invoice.png">
        </div>
        <!-- Glass Overlay Element (z-30) - Floating Micro-animation -->
        <div class="absolute bottom-12 -left-8 z-30 glass-card p-5 rounded-[24px] shadow-xl border border-white/20 max-w-[200px] animate-float-card">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-success/20 flex items-center justify-center text-success">
              <i class="hgi-stroke hgi-checkmark-circle-01 text-[20px]"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-text-primary">Payment Received</p>
              <p class="text-[8px] text-text-secondary">Just now • invoice #442</p>
            </div>
          </div>
          <p class="text-lg font-bold text-primary tabular-nums">₦240,000.00</p>
        </div>
      </div>
    </section>



    <!-- Interactive Distribution & Payment Demo Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="stagger-in">
        <span class="inline-block px-3 py-1 rounded-full bg-success/15 text-success text-[10px] font-bold uppercase tracking-wider mb-4">Instant Distribution</span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-primary mb-6 leading-tight">Send instantly. Get paid seamlessly.</h2>
        <p class="text-base text-text-secondary mb-8 leading-relaxed">
          Create invoices and share them instantly via WhatsApp or Email. Customers receive a direct link to settle invoices securely using cards, USSD, or direct bank transfer via Paystack.
        </p>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-primary/5 flex items-center justify-center text-primary shrink-0">
              <i class="hgi-stroke hgi-mail-01 text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">Email Delivery Automation</p>
              <p class="text-xs text-text-secondary">Kulode auto-sends professional invoices with inline action buttons directly to your customer's inbox.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center text-success shrink-0">
              <i class="hgi-stroke hgi-whatsapp text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">Direct WhatsApp Sharing</p>
              <p class="text-xs text-text-secondary">Copy short payment links or use WhatsApp integrations to send custom alerts that clients can click immediately.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-800 shrink-0">
              <i class="hgi-stroke hgi-flash text-lg"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-text-primary">One-Click Paystack Settlement</p>
              <p class="text-xs text-text-secondary">No complex bank app transfers. Customers pay with bank transfer, card, or USSD via our secured checkout.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Animated illustration container -->
      <div class="relative flex justify-center items-center py-12 stagger-in">
        <!-- Background decorative pulse circle -->
        <div class="absolute w-[360px] h-[360px] rounded-full bg-primary/5 blur-3xl -z-10 animate-pulse"></div>

        <!-- Cutout Image Card of Person Looking at Phone -->
        <div class="relative w-[280px] h-[380px] rounded-[32px] overflow-visible flex items-center justify-center border border-white/60 shadow-2xl bg-white p-2">
          <img src="/person_looking_at_phone.png" alt="Person looking at phone" class="w-full h-full object-cover rounded-[24px] filter" />
          
          <!-- Animation overlays -->
          
          <!-- Email flying card -->
          <div class="absolute -top-6 -left-12 glass-card p-4 rounded-[20px] shadow-lg border border-white/20 max-w-[200px] flex items-center gap-3 animate-float-email">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white shrink-0">
              <i class="hgi-stroke hgi-mail-01 text-sm"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-text-primary leading-tight">Invoice Sent</p>
              <p class="text-[8px] text-text-secondary leading-tight">via email ✉️</p>
            </div>
          </div>

          <!-- WhatsApp Chat bubble -->
          <div class="absolute top-[35%] -right-16 bg-[#d9fdd3] p-4 rounded-[20px] rounded-tr-none shadow-md border border-[#c2f0b7] max-w-[220px] flex items-start gap-3 animate-slide-whatsapp">
            <div class="w-6 h-6 rounded-full bg-[#25d366] flex items-center justify-center text-white shrink-0 mt-0.5">
              <i class="hgi-stroke hgi-whatsapp text-xs text-white"></i>
            </div>
            <div>
              <p class="text-[9px] text-[#128c7e] font-bold">Kulode Notification</p>
              <p class="text-[10px] text-text-primary leading-snug mt-1">Hello! Here is your invoice. Pay instantly at <span class="text-blue-600 underline">pay.kulode.app/inv-001</span></p>
            </div>
          </div>

          <!-- Clicking to pay animation bubble -->
          <div class="absolute -bottom-6 -left-8 bg-white p-4 rounded-[24px] shadow-2xl border border-outline-variant max-w-[220px] animate-pay-flow">
            <div class="text-center">
              <p class="text-[10px] text-text-secondary">Amount Due</p>
              <p class="text-sm font-extrabold text-primary mb-2">₦150,000.00</p>
              <div class="relative inline-block w-full">
                <div class="w-full text-white text-[10px] font-bold py-2.5 rounded-lg flex items-center justify-center gap-1.5 shadow-md shadow-primary/20 relative animate-btn-pay select-none">
                  <span class="pay-text-paynow absolute inset-0 flex items-center justify-center animate-text-paynow">PAY NOW</span>
                  <span class="pay-text-paid absolute inset-0 flex items-center justify-center animate-text-paid opacity-0 text-success bg-success-container font-extrabold">PAID ✓</span>
                </div>
                <!-- Hand clicking cursor -->
                <div class="absolute right-4 bottom-[-16px] w-6 h-6 text-primary animate-cursor-click pointer-events-none">
                  <i class="hgi-stroke hgi-touch-01 text-xl"></i>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="bg-surface-container-low py-32">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-20 stagger-in">
          <h2 class="text-3xl font-extrabold text-primary mb-4">Everything you need to manage your money</h2>
          <p class="text-base text-text-secondary max-w-2xl mx-auto">Stop juggling multiple spreadsheets and apps. Kulode centralizes your entire financial workflow into a single, beautiful dashboard.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Feature 1: Compliance -->
          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300 stagger-in">
            <span class="inline-block px-3 py-1 rounded-full bg-[#ffddb8] text-[#121c28] text-[10px] font-bold uppercase tracking-widest mb-4">Compliance</span>
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-invoice-03 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Automated NFIU Reporting</h3>
            <p class="text-sm text-text-secondary">Auto-prepare required currency reports for the Nigerian Financial Intelligence Unit (NFIU) when cash sales cross ₦5M (for individuals) or ₦10M (for corporates) seamlessly.</p>
          </div>
          <!-- Feature 2: Payments -->
          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300 stagger-in">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-credit-card text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Online Payments & Auto-Reconciliation</h3>
            <p class="text-sm text-text-secondary">Accept local bank transfers, cards, and copy-paste checkout links for WhatsApp or Instagram DMs. Payments are auto-matched instantly.</p>
          </div>
          <!-- Feature 3: Tax -->
          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300 stagger-in">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-wallet-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Tax & FIRS Preparation</h3>
            <p class="text-sm text-text-secondary">Automatically calculate VAT (7.5%) and WHT (2024 simplified rates) and export ready-to-file FIRS tax schedules.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Collaboration Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-32 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <div class="order-2 lg:order-1 relative w-full aspect-video lg:aspect-square flex items-center justify-center min-h-[380px]">
        <!-- Base photo -->
        <div class="w-[85%] rounded-[40px] overflow-hidden shadow-2xl shadow-primary/10 border border-outline-variant/10">
          <img alt="Team Collaboration" class="w-full h-auto object-cover aspect-video lg:aspect-square" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBANxp1viD2yKWSejL3GhhfiNc0kSIhSMZM7gFJ95M9az-zYzBcd1kX-O5hubYxQnibzr8fjmVrh9cnd3K8eX7x_T9i_HDIgnhsVch5M0a-Rv0DQ2nAQkQxGCauV3Qej3GzUwubxkDhDL83tyYeU2Qtxgm_GkiA8l4lE6R-vXqNos_OANYV9ZKRfrHE1YV2Fkqxh5yxS3IQQF_7u3ulL2sMRTHuVg21hHa2FVNO7m55KeugIILhlcM7PXLH0MHsP4IPCFl6yFxhobY">
        </div>
        <!-- Overlapping Settings / Accountant Portal Screen -->
        <div class="absolute -right-4 -bottom-4 w-[60%] z-20 rounded-2xl border border-outline-variant/20 overflow-hidden shadow-2xl bg-surface-container-lowest transition-all hover:scale-[1.02] duration-300">
          <!-- Mini browser bar -->
          <div class="flex items-center gap-1 px-3 py-2 bg-surface-container border-b border-outline-variant/20">
            <div class="flex gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            </div>
          </div>
          <img alt="Analytics Reports" class="w-full h-auto" src="/uploaded_reports_page.png">
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <span class="bg-surface-container px-4 py-2 rounded-full text-primary text-xs font-bold mb-8 inline-block uppercase tracking-wider">For Teams</span>
        <h2 class="text-4xl font-extrabold text-primary mb-8">Scale your operations with multi-user access</h2>
        <p class="text-base text-text-secondary mb-10">Kulode isn't just for solo-preneurs. Grant access to your accountant, business partners, or employees with granular permissions. Manage multiple entities from a single unified profile.</p>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <i class="hgi-stroke hgi-checkmark-circle-01 text-primary mt-1"></i>
            <div>
              <p class="text-lg font-bold text-text-primary">Granular Permissions</p>
              <p class="text-sm text-text-secondary">Control exactly what each team member can see or edit.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <i class="hgi-stroke hgi-checkmark-circle-01 text-primary mt-1"></i>
            <div>
              <p class="text-lg font-bold text-text-primary">Accountant Portal</p>
              <p class="text-sm text-text-secondary">Invite your accountant to pull reports directly, no more emailing files.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Testimonial Section -->
    <section class="bg-primary-container text-on-primary py-32 relative overflow-hidden">
      <!-- Decorative circle -->
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
      <div class="max-w-7xl mx-auto px-container-padding text-center relative z-10">
        <div class="flex justify-center mb-10 text-[#ffffff4d]">
          <i class="hgi-stroke hgi-quote-up text-[64px]"></i>
        </div>
        <blockquote class="text-3xl md:text-4xl leading-snug mb-12 max-w-4xl mx-auto font-bold">"Kulode has completely transformed how I handle my business finances. I get paid within 24 hours and my tax schedules are automatically ready for FIRS."</blockquote>
        <div class="flex flex-col items-center">
          <div class="w-16 h-16 rounded-full bg-surface-container mb-4 overflow-hidden border-2 border-white/20">
            <div class="w-full h-full bg-accent-gradient"></div>
          </div>
          <p class="text-lg font-bold text-white">Adewale Johnson</p>
          <p class="text-xs opacity-70">Creative Director, Studio Nexus</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-container-padding">
      <div class="max-w-5xl mx-auto bg-surface-container p-12 md:p-20 rounded-[48px] text-center shadow-xl border border-white/20">
        <h2 class="text-3xl font-extrabold text-primary mb-6">Ready to get your time back?</h2>
        <p class="text-base text-text-secondary mb-12 max-w-xl mx-auto">Join thousands of entrepreneurs who trust Kulode to power their financial growth. No credit card required to start.</p>
        <a href={`${appUrl}/register`} class="inline-block bg-primary text-on-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all btn-gradient">
          Start your 30-day free trial
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full py-12 bg-surface border-t border-outline-variant">
    <div class="flex flex-col md:flex-row justify-between items-center gap-element-gap px-container-padding max-w-7xl mx-auto">
      <div class="flex flex-col gap-4 items-center md:items-start">
        <span class="text-2xl font-bold tracking-tight text-primary">Kulode</span>
        <p class="text-sm text-text-secondary text-center md:text-left max-w-xs">
          © {new Date().getFullYear()} Kulode. All rights reserved. Built for the modern freelancer.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-8">
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/privacy">Privacy Policy</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/terms">Terms of Service</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="mailto:abubakar.sambo@kulode.app">Contact Support</a>
      </div>
    </div>
  </footer>

  <script>
    // Simple Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                (entry.target as HTMLElement).style.animationPlayState = 'running';
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    document.querySelectorAll('.stagger-in').forEach(el => {
        (el as HTMLElement).style.animationPlayState = 'paused';
        observer.observe(el);
    });

    // Sticky Navbar background shift on scroll
    window.addEventListener('scroll', () => {
        const nav = document.querySelector('nav');
        if (nav) {
            if (window.scrollY > 20) {
                nav.classList.add('shadow-lg');
            } else {
                nav.classList.remove('shadow-lg');
            }
        }
    });
  </script>

  <style>
    /* Keyframes for the person look page animations */
    @keyframes floatEmail {
      0%, 100% {
        transform: translate(0, 40px);
        opacity: 0;
      }
      10%, 40% {
        opacity: 1;
        transform: translate(0, 0);
      }
      50%, 90% {
        transform: translate(-10px, -20px);
        opacity: 1;
      }
    }

    @keyframes slideWhatsapp {
      0%, 100% {
        transform: translate(30px, 10px);
        opacity: 0;
      }
      10%, 40% {
        opacity: 1;
        transform: translate(0, 0);
      }
      50%, 90% {
        transform: translate(5px, -5px);
        opacity: 1;
      }
    }

    @keyframes payFlow {
      0%, 100% {
        transform: scale(1);
      }
      45% {
        transform: scale(1);
      }
      50% {
        transform: scale(0.98);
      }
      60% {
        transform: scale(1);
      }
    }

    @keyframes cursorClick {
      0%, 100% {
        transform: translate(15px, 15px) scale(1);
        opacity: 0;
      }
      40% {
        transform: translate(5px, 5px) scale(1);
        opacity: 1;
      }
      50% {
        transform: translate(0, 0) scale(0.85);
        opacity: 1;
      }
      60% {
        transform: translate(10px, 10px) scale(1);
        opacity: 0;
      }
    }

    @keyframes btnPayBg {
      0%, 48%, 95%, 100% {
        background-color: #0037b0;
      }
      52%, 90% {
        background-color: #006c49;
      }
    }

    @keyframes textPayNow {
      0%, 48%, 95%, 100% {
        opacity: 1;
      }
      52%, 90% {
        opacity: 0;
      }
    }

    @keyframes textPaid {
      0%, 48%, 95%, 100% {
        opacity: 0;
      }
      52%, 90% {
        opacity: 1;
      }
    }

    .animate-float-email {
      animation: floatEmail 6s cubic-bezier(0.25, 1, 0.5, 1) infinite;
    }

    .animate-slide-whatsapp {
