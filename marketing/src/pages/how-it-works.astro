---
import Layout from '../layouts/Layout.astro'

const appUrl = 'http://localhost:5173'
---

<Layout title="How it Works — Kulode">
  <!-- Nav -->
  <nav class="w-full sticky top-0 z-50 bg-background/80 backdrop-blur-xl shadow-[0_12px_32px_rgba(0,55,176,0.08)]">
    <div class="flex justify-between items-center px-container-padding max-w-7xl mx-auto h-[72px]">
      <div class="flex items-center gap-12">
        <a href="/" class="text-[24px] font-extrabold tracking-tighter text-primary">Kulode</a>
        <div class="hidden md:flex items-center gap-8">
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/#features">Features</a>
          <a class="text-sm text-primary font-bold" href="/how-it-works">How It Works</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/pricing">Pricing</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/invoicing">Solutions</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/tax-filing">Tax Filing</a>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href={`${appUrl}/login`} class="text-sm font-medium text-text-secondary px-6 py-2 transition-all hover:text-primary active:scale-95">Login</a>
        <a href={`${appUrl}/register`} class="bg-primary text-on-primary px-6 py-3 rounded-[12px] text-sm font-bold shadow-lg shadow-primary/20 hover:shadow-xl transition-all active:scale-95 btn-gradient">Get Started</a>
      </div>
    </div>
  </nav>

  <main class="hero-gradient bg-surface">
    <!-- Hero Header -->
    <section class="max-w-7xl mx-auto px-container-padding pt-20 pb-16 text-center stagger-in">
      <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-6">Workflow Simplified</span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-primary tracking-tight mb-6 max-w-3xl mx-auto leading-tight">
        A financial engine built for <span class="text-surface-tint">compliance & speed</span>
      </h1>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto mb-10">
        From first click to tax season, Kulode automates your core billing cycles, connects you directly to local payment methods, and keeps you aligned with FIRS and NFIU regulations.
      </p>
    </section>



    <!-- The 4-Step Visual Flow -->
    <section class="py-16 max-w-7xl mx-auto px-container-padding">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
        <!-- Connecting line decoration for desktop -->
        <div class="hidden lg:block absolute top-1/4 left-1/8 right-1/8 h-0.5 bg-outline-variant -z-10"></div>

        <!-- Step 1 -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant hover:border-primary/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-briefcase-02 text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">1</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Setup Organization</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Create your workspace. Set your currency, default notes, payment terms, prefix, and enable VAT compliance.
            </p>
          </div>
          <div class="mt-6 w-full rounded-xl border border-outline-variant/15 overflow-hidden shadow bg-surface-container-lowest relative aspect-[16/10]">
            <div class="flex items-center gap-1 px-3 py-1.5 bg-surface-container border-b border-outline-variant/10">
              <div class="flex gap-0.5 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              </div>
            </div>
            <img src="/media__1780754425333.png" alt="Workspace Setup" class="w-full h-full object-cover object-top" />
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant hover:border-primary/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-bank text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">2</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Link Settlement Bank</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Add bank details to register your Paystack subaccount. Get verified to routing incoming payments directly.
            </p>
          </div>
          <div class="mt-6 w-full rounded-xl border border-outline-variant/15 overflow-hidden shadow bg-surface-container-lowest relative aspect-[16/10]">
            <div class="flex items-center gap-1 px-3 py-1.5 bg-surface-container border-b border-outline-variant/10">
              <div class="flex gap-0.5 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              </div>
            </div>
            <img src="/media__1780754387896.png" alt="Bank subaccount link" class="w-full h-full object-cover object-top" />
          </div>
        </div>

        <!-- Step 3 -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant hover:border-primary/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-invoice-03 text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">3</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Issue & Collect</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Send shareable links. Clients pay via bank transfer or card. The system auto-updates invoice states.
            </p>
          </div>
          <div class="mt-6 w-full rounded-xl border border-outline-variant/15 overflow-hidden shadow bg-surface-container-lowest relative aspect-[16/10]">
            <div class="flex items-center gap-1 px-3 py-1.5 bg-surface-container border-b border-outline-variant/10">
              <div class="flex gap-0.5 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              </div>
            </div>
            <img src="/media__1780773453664.png" alt="Issue Invoices and Track" class="w-full h-full object-cover object-top" />
          </div>
        </div>

        <!-- Step 4 -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant hover:border-primary/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-auction text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">4</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Automate Compliance</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Expense logs automatically prepare VAT/WHT schedules. Track SCUML transaction limits effortlessly.
            </p>
          </div>
          <div class="mt-6 w-full rounded-xl border border-outline-variant/15 overflow-hidden shadow bg-surface-container-lowest relative aspect-[16/10]">
            <div class="flex items-center gap-1 px-3 py-1.5 bg-surface-container border-b border-outline-variant/10">
              <div class="flex gap-0.5 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              </div>
            </div>
            <img src="/media__1780773565479.png" alt="Automate Compliance & Tax" class="w-full h-full object-cover object-top" />
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Invoice Sandbox Simulator -->
    <section class="py-24 bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-16 stagger-in">
          <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">Live Sandbox</span>
          <h2 class="text-3xl font-extrabold text-primary mb-4">Try the Invoice Simulator</h2>
          <p class="text-base text-text-secondary max-w-2xl mx-auto">
            Experience how easy invoice generation is with Kulode. Change the values below to watch the invoice compute and updates in real-time.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start stagger-in">
          <!-- Configuration panel -->
          <div class="bg-white p-8 md:p-10 rounded-[32px] shadow-xl border border-outline-variant">
            <h3 class="text-xl font-bold text-text-primary mb-8 flex items-center gap-3">
              <i class="hgi-stroke hgi-settings-02 text-primary"></i>
              Invoice Parameters
            </h3>

            <div class="space-y-6">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-desc">Item Description</label>
                <input id="sim-desc" type="text" value="Premium Consulting Services" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-price">Unit Price (₦)</label>
                  <input id="sim-price" type="number" value="150000" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-qty">Quantity</label>
                  <input id="sim-qty" type="number" value="2" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-discount">Discount (%)</label>
                  <input id="sim-discount" type="number" min="0" max="100" value="10" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2">VAT Compliance</label>
                  <div class="flex items-center gap-3 h-[44px]">
                    <input id="sim-vat" type="checkbox" checked class="w-5 h-5 accent-primary rounded cursor-pointer" />
                    <span class="text-sm text-text-secondary font-medium">Add 7.5% VAT</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Live Mock Invoice Preview -->
          <div class="glass-card rounded-[32px] p-8 md:p-10 shadow-[0_24px_48px_rgba(0,55,176,0.06)] border border-white/40 relative overflow-hidden float-slow">
            <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -z-10"></div>
            
            <div class="flex justify-between items-start mb-8">
              <div>
                <span class="text-lg font-extrabold tracking-tighter text-primary">Kulode Simulator</span>
                <p class="text-[10px] text-text-secondary mt-1">ACME Solutions Ltd</p>
              </div>
              <div class="text-right">
                <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-[10px] font-extrabold uppercase">DRAFT</span>
                <p class="text-[10px] text-text-secondary mt-2">Invoice #INV-001</p>
              </div>
            </div>

            <!-- Invoice Item Row -->
            <div class="border-b border-outline-variant/60 pb-6 mb-6">
              <p class="text-xs uppercase tracking-wider font-extrabold text-text-secondary mb-4">Description</p>
              <div class="flex justify-between items-center">
                <div>
                  <p class="text-sm font-bold text-text-primary" id="preview-desc">Premium Consulting Services</p>
                  <p class="text-xs text-text-secondary mt-1">Qty: <span id="preview-qty">2</span> × ₦<span id="preview-price">150,000.00</span></p>
                </div>
                <p class="text-sm font-bold text-text-primary tabular-nums">₦<span id="preview-raw-total">300,000.00</span></p>
              </div>
            </div>

            <!-- Invoice Summary -->
            <div class="space-y-3 pl-1/4">
              <div class="flex justify-between text-xs text-text-secondary">
                <span>Subtotal</span>
                <span class="tabular-nums">₦<span id="preview-subtotal">300,000.00</span></span>
              </div>
              <div class="flex justify-between text-xs text-rose-600 font-medium">
                <span>Discount (<span id="preview-discount-percent">10</span>%)</span>
                <span class="tabular-nums">-₦<span id="preview-discount">30,000.00</span></span>
              </div>
              <div class="flex justify-between text-xs text-text-secondary" id="preview-vat-row">
                <span>VAT (7.5%)</span>
                <span class="tabular-nums">₦<span id="preview-vat">20,250.00</span></span>
              </div>
              <div class="flex justify-between text-sm font-extrabold text-primary border-t border-outline-variant/60 pt-3">
                <span>Total Amount Due</span>
                <span class="tabular-nums">₦<span id="preview-total">290,250.00</span></span>
              </div>
            </div>

            <!-- Footer Message -->
            <p class="text-[10px] text-center text-text-secondary mt-10 italic">
              Payments are routed directly to your settlement account via Paystack.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call To Action -->
    <section class="py-32 px-container-padding bg-surface">
      <div class="max-w-5xl mx-auto bg-primary text-white p-12 md:p-20 rounded-[48px] text-center shadow-[0_24px_48px_rgba(0,55,176,0.15)] relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl"></div>
        <h2 class="text-3xl md:text-4xl font-extrabold mb-6 leading-tight">Ready to transform your business invoicing?</h2>
        <p class="text-base opacity-80 mb-10 max-w-xl mx-auto">
          Start invoicing today. No commitment, cancel anytime. Join thousands of African freelancers.
        </p>
        <a href={`${appUrl}/register`} class="inline-block bg-white text-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl hover:scale-105 active:scale-95 transition-all">
          Start Your 30-Day Free Trial
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full py-12 bg-surface border-t border-outline-variant">
    <div class="flex flex-col md:flex-row justify-between items-center gap-element-gap px-container-padding max-w-7xl mx-auto">
      <div class="flex flex-col gap-4 items-center md:items-start">
        <span class="text-2xl font-bold tracking-tight text-primary">Kulode</span>
        <p class="text-sm text-text-secondary text-center md:text-left max-w-xs">
          © {new Date().getFullYear()} Kulode. All rights reserved. Built for the modern freelancer.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-8">
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/privacy">Privacy Policy</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/terms">Terms of Service</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="mailto:abubakar.sambo@kulode.app">Contact Support</a>
      </div>
    </div>
  </footer>

  <script>
    // Intersection Observer for scroll stagger animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.stagger-in').forEach(el => {
      (el as HTMLElement).style.animationPlayState = 'paused';
      observer.observe(el);
    });

    // Invoice sandbox logic
    const inputDesc = document.getElementById('sim-desc') as HTMLInputElement;
    const inputPrice = document.getElementById('sim-price') as HTMLInputElement;
    const inputQty = document.getElementById('sim-qty') as HTMLInputElement;
    const inputDiscount = document.getElementById('sim-discount') as HTMLInputElement;
    const inputVat = document.getElementById('sim-vat') as HTMLInputElement;

    const previewDesc = document.getElementById('preview-desc') as HTMLParagraphElement;
    const previewQty = document.getElementById('preview-qty') as HTMLSpanElement;
    const previewPrice = document.getElementById('preview-price') as HTMLSpanElement;
    const previewRawTotal = document.getElementById('preview-raw-total') as HTMLSpanElement;
    const previewSubtotal = document.getElementById('preview-subtotal') as HTMLSpanElement;
    const previewDiscountPercent = document.getElementById('preview-discount-percent') as HTMLSpanElement;
    const previewDiscount = document.getElementById('preview-discount') as HTMLSpanElement;
    const previewVatRow = document.getElementById('preview-vat-row') as HTMLDivElement;
    const previewVat = document.getElementById('preview-vat') as HTMLSpanElement;
    const previewTotal = document.getElementById('preview-total') as HTMLSpanElement;

    function formatCurrency(val: number): string {
      return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calculate() {
      const desc = inputDesc.value || 'Custom Invoice Item';
      const price = parseFloat(inputPrice.value) || 0;
      const qty = parseFloat(inputQty.value) || 0;
      const discountPercent = parseFloat(inputDiscount.value) || 0;
      const hasVat = inputVat.checked;

      const rawTotal = price * qty;
      const subtotal = rawTotal;
      const discountVal = (subtotal * discountPercent) / 100;
      const subtotalAfterDiscount = subtotal - discountVal;
      const vatVal = hasVat ? (subtotalAfterDiscount * 0.075) : 0;
      const total = subtotalAfterDiscount + vatVal;

      previewDesc.textContent = desc;
      previewQty.textContent = qty.toString();
      previewPrice.textContent = formatCurrency(price);
      previewRawTotal.textContent = formatCurrency(rawTotal);
      previewSubtotal.textContent = formatCurrency(subtotal);
      previewDiscountPercent.textContent = discountPercent.toString();
      previewDiscount.textContent = formatCurrency(discountVal);
      
      if (hasVat) {
        previewVatRow.style.display = 'flex';
        previewVat.textContent = formatCurrency(vatVal);
      } else {
        previewVatRow.style.display = 'none';
      }

      previewTotal.textContent = formatCurrency(total);
    }

    // Bind event listeners
    [inputDesc, inputPrice, inputQty, inputDiscount, inputVat].forEach(elem => {
      if (elem) {
        elem.addEventListener('input', calculate);
        elem.addEventListener('change', calculate);
      }
    });

    // Run initial calculation
    calculate();
  </script>


</Layout>
