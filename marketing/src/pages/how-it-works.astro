---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
---

<Layout
  title="How It Works — Tari1"
  description="From menu setup to shift close: how Tari1 runs order taking, the kitchen display, table management, and cash reconciliation for Nigerian restaurants."
>
  <Navbar activePage="how-it-works" />

  <main class="hero-gradient bg-surface">
    <!-- Hero Header -->
    <section class="max-w-7xl mx-auto px-container-padding pt-20 pb-16 text-center stagger-in">
      <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-6">Service Simplified</span>
      <h1 class="text-4xl md:text-6xl font-bold text-primary tracking-tight mb-6 max-w-3xl mx-auto leading-tight">
        A POS built for <span class="text-surface-tint">speed & reliability</span>
      </h1>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto mb-10">
        From the first table you map to the last shift you close, Tari1 runs order taking, the kitchen display, and cash reconciliation in one place — and keeps working even when the network doesn't.
      </p>
    </section>

    <!-- The 4-Step Visual Flow -->
    <section class="py-16 max-w-7xl mx-auto px-container-padding">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
        <!-- Connecting line decoration for desktop -->
        <div class="hidden lg:block absolute top-1/4 left-1/8 right-1/8 h-0.5 bg-outline-variant -z-10"></div>

        <!-- ── Step 1 ── -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in group cursor-pointer relative overflow-hidden">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-restaurant-01 text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">1</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Set Up Menu & Floor</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Add your menu items and categories, map your tables into sections, and set your VAT and service charge rates.
            </p>
          </div>
          <div class="mt-6 w-[80%] rounded-[24px] border-[5px] border-slate-900 overflow-hidden shadow-lg bg-slate-900 relative aspect-[9/16]">
            <img src="/mobile_step1_setup.png" alt="Menu and floor setup mobile view" class="w-full h-full object-cover" />
            <!-- overlay — hidden by default, revealed on .group:hover via CSS -->
            <div class="step-overlay absolute inset-0 bg-black/50 flex flex-col justify-center items-center gap-3 p-4 backdrop-blur-[2px]">
              <div class="step1-card-a bg-white rounded-xl p-3 shadow-lg w-full max-w-[140px] text-left border border-white/20">
                <p class="text-[9px] font-bold text-text-primary flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-[8px] font-extrabold">✓</span>
                  Menu synced
                </p>
              </div>
              <div class="step1-card-b bg-white rounded-xl p-3 shadow-lg w-full max-w-[140px] text-left border border-white/20">
                <p class="text-[9px] font-bold text-text-primary flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-[8px] font-extrabold">✓</span>
                  12 tables mapped
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Step 2 ── -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in group cursor-pointer relative overflow-hidden">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-user-group text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">2</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Add Staff & Pair Printers</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Set up waiters, cashiers, and admins with role-based access, then pair your kitchen and receipt printers.
            </p>
          </div>
          <div class="mt-6 w-[80%] rounded-[24px] border-[5px] border-slate-900 overflow-hidden shadow-lg bg-slate-900 relative aspect-[9/16]">
            <img src="/mobile_step2_bank.png" alt="Staff and printer setup mobile view" class="w-full h-full object-cover" />
            <div class="step-overlay absolute inset-0 bg-black/50 flex flex-col justify-center items-center p-4 backdrop-blur-[2px]">
              <div class="relative flex items-center justify-center">
                <!-- Sonar rings — animated via .group:hover CSS below -->
                <div class="step2-ring-1 absolute w-12 h-12 rounded-full border-2 border-emerald-400"></div>
                <div class="step2-ring-2 absolute w-12 h-12 rounded-full border-2 border-emerald-300"></div>
                <div class="step2-shield w-12 h-12 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-xl relative z-10 text-xl font-bold">
                  ✓
                </div>
              </div>
              <div class="step2-label bg-white rounded-lg px-3 py-1.5 shadow-md text-[9px] font-bold text-slate-800 mt-4">
                Kitchen printer paired ⚡
              </div>
            </div>
          </div>
        </div>

        <!-- ── Step 3 ── -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in group cursor-pointer relative overflow-hidden">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-chef-hat text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">3</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Take & Fire Orders</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Waiters send the order from the table. It lands on the kitchen display instantly, with a prep timer running.
            </p>
          </div>
          <div class="mt-6 w-[80%] rounded-[24px] border-[5px] border-slate-900 overflow-hidden shadow-lg bg-slate-900 relative aspect-[9/16]">
            <img src="/mobile_step3_invoice.png" alt="Order taking mobile view" class="w-full h-full object-cover" />
            <div class="step-overlay absolute inset-0 bg-black/50 backdrop-blur-[1px]">
              <!-- Typing bubble -->
              <div class="step3-typing absolute bottom-[72px] left-1/2 -translate-x-1/2 bg-white rounded-2xl px-3 py-2 shadow-md flex items-center gap-1.5 w-14 justify-center">
                <span class="step3-dot w-1.5 h-1.5 rounded-full bg-slate-400" style="animation-delay:0s"></span>
                <span class="step3-dot w-1.5 h-1.5 rounded-full bg-slate-400" style="animation-delay:0.2s"></span>
                <span class="step3-dot w-1.5 h-1.5 rounded-full bg-slate-400" style="animation-delay:0.4s"></span>
              </div>
              <!-- Kitchen ticket message bubble -->
              <div class="step3-bubble absolute bottom-[52px] left-1/2 -translate-x-1/2 bg-[#d9fdd3] rounded-xl rounded-tr-none p-2 border border-[#c2f0b7] w-[128px]">
                <p class="text-[8px] leading-snug text-slate-800">Table 4: Jollof x2, Suya x1 🍽️</p>
                <div class="flex justify-end items-center mt-1 gap-1 text-[7px] text-slate-500">
                  <span>09:41</span>
                  <!-- grey ticks -->
                  <span class="step3-ticks-grey">✓✓</span>
                  <!-- blue ticks -->
                  <span class="step3-ticks-blue text-[#34b7f1]">✓✓</span>
                </div>
              </div>
              <!-- Toast -->
              <div class="step3-toast absolute bottom-3 left-1/2 -translate-x-1/2 bg-white rounded-lg px-2.5 py-1.5 shadow-lg border border-slate-100 text-[8px] font-bold text-slate-700 whitespace-nowrap flex items-center gap-1.5">
                <span class="text-[#25d366]">🔥</span> Seen by kitchen
              </div>
            </div>
          </div>
        </div>

        <!-- ── Step 4 ── -->
        <div class="bg-surface-container-lowest p-8 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.03)] border border-outline-variant transition-all duration-300 flex flex-col justify-between items-center text-center stagger-in group cursor-pointer relative overflow-hidden">
          <div>
            <div class="w-16 h-16 rounded-full bg-primary/5 flex items-center justify-center text-primary mb-6 ring-8 ring-primary/2 mx-auto">
              <i class="hgi-stroke hgi-file-verified text-[32px]"></i>
            </div>
            <div class="bg-primary text-white text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center mb-4 mx-auto">4</div>
            <h3 class="text-lg font-bold text-text-primary mb-2">Close & Reconcile</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Count the till against expected cash, catch any variance, and download a shift report — every night, without spreadsheets.
            </p>
          </div>
          <div class="mt-6 w-[80%] rounded-[24px] border-[5px] border-slate-900 overflow-hidden shadow-lg bg-slate-900 relative aspect-[9/16]">
            <img src="/mobile_step4_tax.png" alt="Shift close mobile view" class="w-full h-full object-cover" />
            <div class="step-overlay absolute inset-0 bg-black/50 flex flex-col justify-center items-center p-3 backdrop-blur-[2px]">
              <!-- Progress card -->
              <div class="step4-card bg-white rounded-xl p-3 shadow-xl w-[85%] max-w-[130px] border border-white/10 relative overflow-hidden min-h-[54px] flex flex-col justify-center">
                <!-- Downloading state -->
                <div class="step4-downloading w-full text-center">
                  <p class="text-[8px] font-extrabold text-blue-700 mb-1.5">Counting Cash</p>
                  <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden relative">
                    <div class="step4-bar h-full bg-blue-600 rounded-full absolute left-0 top-0">
                      <div class="step4-shimmer absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent -skew-x-12"></div>
                    </div>
                  </div>
                </div>
                <!-- Done state -->
                <div class="step4-done absolute inset-0 bg-white rounded-xl flex flex-col justify-center items-center">
                  <span class="text-xl mb-1">✅</span>
                  <p class="text-[8px] font-extrabold text-emerald-600">Variance ₦0</p>
                </div>
              </div>
              <!-- Toast -->
              <div class="step4-toast absolute bottom-3 left-1/2 -translate-x-1/2 bg-emerald-600 text-white rounded-lg px-2.5 py-1.5 shadow-md text-[8px] font-bold whitespace-nowrap">
                Shift report saved ✓
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Order Total Simulator -->
    <section class="py-24 bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-16 stagger-in">
          <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">Live Sandbox</span>
          <h2 class="text-3xl font-extrabold text-primary mb-4">Try the Order Simulator</h2>
          <p class="text-base text-text-secondary max-w-2xl mx-auto">
            See exactly how Tari1 totals a table's order. Change the values below and watch VAT and the total update in real-time — the same math your cashiers see at checkout.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start stagger-in">
          <!-- Configuration panel -->
          <div class="bg-white p-8 md:p-10 rounded-[32px] shadow-xl border border-outline-variant">
            <h3 class="text-xl font-bold text-text-primary mb-8 flex items-center gap-3">
              <i class="hgi-stroke hgi-settings-02 text-primary"></i>
              Order Parameters
            </h3>

            <div class="space-y-6">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-desc">Menu Item</label>
                <input id="sim-desc" type="text" value="Jollof Rice" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-price">Unit Price (₦)</label>
                  <input id="sim-price" type="number" value="2500" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-qty">Quantity</label>
                  <input id="sim-qty" type="number" value="4" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2" for="sim-discount">Discount (%)</label>
                  <input id="sim-discount" type="number" min="0" max="100" value="0" class="w-full px-4 py-3 rounded-[12px] border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 text-sm tabular-nums" />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-text-secondary mb-2">VAT</label>
                  <label class="flex items-center gap-3 h-[44px] cursor-pointer select-none">
                    <input id="sim-vat" type="checkbox" checked class="sr-only peer" />
                    <div class="vat-box w-6 h-6 rounded-[6px] border-2 border-slate-300 bg-white flex items-center justify-center transition-all duration-300 relative">
                      <svg class="vat-check w-4 h-4 text-white stroke-2 stroke-current fill-none" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                    <span class="text-sm text-text-secondary font-medium peer-checked:text-text-primary transition-colors">Add 7.5% VAT</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Live Mock Order Preview -->
          <div class="glass-card rounded-[32px] p-8 md:p-10 shadow-[0_24px_48px_rgba(0,55,176,0.06)] border border-white/40 relative overflow-hidden float-slow">
            <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-[100px] -z-10"></div>

            <div class="flex justify-between items-start mb-8">
              <div>
                <span class="text-lg font-extrabold tracking-tighter text-primary">Tari1 Simulator</span>
                <p class="text-[10px] text-text-secondary mt-1">The Grill House · Table 4</p>
              </div>
              <div class="text-right">
                <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-[10px] font-extrabold uppercase">OPEN</span>
                <p class="text-[10px] text-text-secondary mt-2">Order #ORD-1042</p>
              </div>
            </div>

            <!-- Order Item Row -->
            <div class="border-b border-outline-variant/60 pb-6 mb-6">
              <p class="text-xs uppercase tracking-wider font-extrabold text-text-secondary mb-4">Item</p>
              <div class="flex justify-between items-center">
                <div>
                  <p class="text-sm font-bold text-text-primary" id="preview-desc">Jollof Rice</p>
                  <p class="text-xs text-text-secondary mt-1">Qty: <span id="preview-qty" class="inline-block">4</span> × ₦<span id="preview-price" class="inline-block">2,500.00</span></p>
                </div>
                <p class="text-sm font-bold text-text-primary tabular-nums">₦<span id="preview-raw-total" class="inline-block">10,000.00</span></p>
              </div>
            </div>

            <!-- Order Summary -->
            <div class="space-y-3">
              <div class="flex justify-between text-xs text-text-secondary">
                <span>Subtotal</span>
                <span class="tabular-nums">₦<span id="preview-subtotal" class="inline-block">10,000.00</span></span>
              </div>
              <div class="flex justify-between text-xs text-rose-600 font-medium">
                <span>Discount (<span id="preview-discount-percent">0</span>%)</span>
                <span class="tabular-nums">-₦<span id="preview-discount" class="inline-block">0.00</span></span>
              </div>
              <div class="flex justify-between text-xs text-text-secondary" id="preview-vat-row">
                <span>VAT (7.5%)</span>
                <span class="tabular-nums">₦<span id="preview-vat" class="inline-block">750.00</span></span>
              </div>
              <div class="flex justify-between text-sm font-extrabold text-primary border-t border-outline-variant/60 pt-3">
                <span>Total Due</span>
                <span class="tabular-nums">₦<span id="preview-total" class="inline-block">10,750.00</span></span>
              </div>
            </div>

            <!-- Footer Message -->
            <p class="text-[10px] text-center text-text-secondary mt-10 italic">
              Charge the table with cash, card, bank transfer, or Paystack.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call To Action -->
    <section class="py-32 px-container-padding bg-surface">
      <div class="max-w-5xl mx-auto bg-primary text-white p-12 md:p-20 rounded-[48px] text-center shadow-[0_24px_48px_rgba(0,55,176,0.15)] relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full blur-2xl"></div>
        <h2 class="text-3xl md:text-4xl font-extrabold mb-6 leading-tight">Ready to run a faster floor?</h2>
        <p class="text-base opacity-80 mb-10 max-w-xl mx-auto">
          Start taking orders today. No credit card required. Cancel before day 30 at no cost.
        </p>
        <a href={`${appUrl}/register`} class="inline-block bg-white text-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl hover:scale-105 active:scale-95 transition-all">
          Start Your 30-Day Free Trial
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Scroll stagger animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.stagger-in').forEach(el => {
      (el as HTMLElement).style.animationPlayState = 'paused';
      observer.observe(el);
    });

    // Custom VAT checkbox
    const vatInput = document.getElementById('sim-vat') as HTMLInputElement;
    const vatBox = document.querySelector('.vat-box') as HTMLElement;
    function syncVatBox() {
      if (vatInput.checked) {
        vatBox.style.background = '#0037b0';
        vatBox.style.borderColor = '#0037b0';
      } else {
        vatBox.style.background = '#ffffff';
        vatBox.style.borderColor = '#c4c5d7';
      }
    }
    vatInput?.addEventListener('change', syncVatBox);
    syncVatBox();

    // Order sandbox logic
    const inputDesc     = document.getElementById('sim-desc') as HTMLInputElement;
    const inputPrice    = document.getElementById('sim-price') as HTMLInputElement;
    const inputQty      = document.getElementById('sim-qty') as HTMLInputElement;
    const inputDiscount = document.getElementById('sim-discount') as HTMLInputElement;
    const inputVat      = document.getElementById('sim-vat') as HTMLInputElement;

    const previewDesc            = document.getElementById('preview-desc') as HTMLElement;
    const previewQty             = document.getElementById('preview-qty') as HTMLElement;
    const previewPrice           = document.getElementById('preview-price') as HTMLElement;
    const previewRawTotal        = document.getElementById('preview-raw-total') as HTMLElement;
    const previewSubtotal        = document.getElementById('preview-subtotal') as HTMLElement;
    const previewDiscountPercent = document.getElementById('preview-discount-percent') as HTMLElement;
    const previewDiscount        = document.getElementById('preview-discount') as HTMLElement;
    const previewVatRow          = document.getElementById('preview-vat-row') as HTMLElement;
    const previewVat             = document.getElementById('preview-vat') as HTMLElement;
    const previewTotal           = document.getElementById('preview-total') as HTMLElement;

    function fmt(val: number): string {
      return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function pulse(el: HTMLElement | null) {
      if (!el) return;
      el.classList.remove('num-pulse');
      void el.offsetWidth;
      el.classList.add('num-pulse');
    }

    let firstRun = true;
    function calculate() {
      const desc    = inputDesc.value || 'Menu Item';
      const price   = parseFloat(inputPrice.value) || 0;
      const qty     = parseFloat(inputQty.value) || 0;
      const disc    = parseFloat(inputDiscount.value) || 0;
      const hasVat  = inputVat.checked;

      const raw     = price * qty;
      const discVal = (raw * disc) / 100;
      const after   = raw - discVal;
      const vatVal  = hasVat ? after * 0.075 : 0;
      const total   = after + vatVal;

      previewDesc.textContent            = desc;
      previewQty.textContent             = qty.toString();
      previewPrice.textContent           = fmt(price);
      previewRawTotal.textContent        = fmt(raw);
      previewSubtotal.textContent        = fmt(raw);
      previewDiscountPercent.textContent = disc.toString();
      previewDiscount.textContent        = fmt(discVal);
      previewVatRow.style.display        = hasVat ? 'flex' : 'none';
      if (hasVat) previewVat.textContent = fmt(vatVal);
      previewTotal.textContent           = fmt(total);

      if (!firstRun) {
        [previewQty, previewPrice, previewRawTotal, previewSubtotal, previewDiscount, previewVat, previewTotal]
          .forEach(pulse);
      }
      firstRun = false;
    }

    [inputDesc, inputPrice, inputQty, inputDiscount].forEach(el => {
      el?.addEventListener('input', calculate);
    });
    vatInput?.addEventListener('change', calculate);
    calculate();
  </script>

  <style>
    /* ── Overlay visibility controlled purely via CSS .group:hover ── */
    .step-overlay {
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .group:hover .step-overlay {
      opacity: 1;
    }

    /* Phone frame scale on hover */
    .group:hover .aspect-\[9\/16\] {
      transform: scale(1.04);
      box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }
    .aspect-\[9\/16\] {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* ── Step 1: staggered card slide-up ── */
    .step1-card-a,
    .step1-card-b {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .group:hover .step1-card-a {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.1s;
    }
    .group:hover .step1-card-b {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.25s;
    }

    /* ── Step 2: sonar rings + shield pop ── */
    .step2-ring-1,
    .step2-ring-2 {
      opacity: 0;
    }
    .group:hover .step2-ring-1 {
      animation: sonarRing 1.6s ease-out infinite;
      animation-delay: 0s;
    }
    .group:hover .step2-ring-2 {
      animation: sonarRing 1.6s ease-out infinite;
      animation-delay: 0.5s;
    }
    @keyframes sonarRing {
      0%   { transform: scale(0.8); opacity: 0.8; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    .step2-shield {
      transform: scale(0.5);
      transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
      transition-delay: 0.1s;
    }
    .group:hover .step2-shield {
      transform: scale(1);
    }
    .step2-label {
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.4s ease, transform 0.4s ease;
      transition-delay: 0.3s;
    }
    .group:hover .step2-label {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── Step 3: ticket staged sequence ── */
    .step3-typing {
      opacity: 0;
    }
    .step3-dot {
      animation: none;
    }
    .step3-bubble {
      opacity: 0;
      transform: scale(0.7) translateY(8px);
    }
    .step3-ticks-grey { display: inline; }
    .step3-ticks-blue { display: none; }
    .step3-toast {
      opacity: 0;
      transform: translateY(14px);
    }

    /* On hover, run the 4.5s looping sequence */
    .group:hover .step3-typing {
      animation: wa-typing-seq 4.5s ease-in-out infinite;
    }
    .group:hover .step3-dot {
      animation: wa-dot-bounce 0.6s ease-in-out infinite alternate;
    }
    .group:hover .step3-dot:nth-child(2) { animation-delay: 0.15s; }
    .group:hover .step3-dot:nth-child(3) { animation-delay: 0.3s; }
    .group:hover .step3-bubble {
      animation: wa-bubble-seq 4.5s cubic-bezier(0.34,1.56,0.64,1) infinite;
    }
    .group:hover .step3-ticks-grey {
      animation: wa-ticks-grey 4.5s ease-in-out infinite;
    }
    .group:hover .step3-ticks-blue {
      display: inline;
      animation: wa-ticks-blue 4.5s ease-in-out infinite;
    }
    .group:hover .step3-toast {
      animation: wa-toast-seq 4.5s cubic-bezier(0.34,1.56,0.64,1) infinite;
    }

    @keyframes wa-dot-bounce {
      from { transform: translateY(0); }
      to   { transform: translateY(-3px); }
    }
    @keyframes wa-typing-seq {
      0%        { opacity:0; transform:scale(0.9) translateY(4px); }
      5%        { opacity:1; transform:scale(1) translateY(0); }
      22%       { opacity:1; }
      28%, 100% { opacity:0; transform:scale(0.9) translateY(-4px); }
    }
    @keyframes wa-bubble-seq {
      0%, 26%  { opacity:0; transform:scale(0.7) translateY(8px); }
      32%      { opacity:1; transform:scale(1.05) translateY(0); }
      36%, 100%{ opacity:1; transform:scale(1) translateY(0); }
    }
    @keyframes wa-ticks-grey {
      0%, 35%   { opacity:1; }
      52%, 100% { opacity:0; }
    }
    @keyframes wa-ticks-blue {
      0%, 53%   { opacity:0; }
      58%, 100% { opacity:1; }
    }
    @keyframes wa-toast-seq {
      0%, 65%   { opacity:0; transform:translateY(14px); }
      72%       { opacity:1; transform:translateY(-2px); }
      77%, 100% { opacity:1; transform:translateY(0); }
    }

    /* ── Step 4: reconciliation progress sequence ── */
    .step4-card {
      transform: scale(0.9);
      transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .group:hover .step4-card {
      transform: scale(1);
    }
    .step4-bar  { width: 0; }
    .step4-shimmer { transform: skewX(-12deg) translateX(-100%); }
    .step4-done { opacity: 0; }
    .step4-toast { opacity: 0; transform: translateY(14px); }

    .group:hover .step4-bar {
      animation: bar-fill 4.5s ease-in-out infinite;
    }
    .group:hover .step4-shimmer {
      animation: shimmer-sweep 1.3s linear infinite;
    }
    .group:hover .step4-downloading {
      animation: dl-state 4.5s ease-in-out infinite;
    }
    .group:hover .step4-done {
      animation: done-state 4.5s cubic-bezier(0.34,1.56,0.64,1) infinite;
    }
    .group:hover .step4-toast {
      animation: dl-toast 4.5s cubic-bezier(0.34,1.56,0.64,1) infinite;
    }

    @keyframes bar-fill {
      0%, 10%   { width:0; }
      60%, 100% { width:100%; }
    }
    @keyframes shimmer-sweep {
      0%   { transform:skewX(-12deg) translateX(-100%); }
      100% { transform:skewX(-12deg) translateX(280%); }
    }
    @keyframes dl-state {
      0%, 62%   { opacity:1; }
      68%, 100% { opacity:0; }
    }
    @keyframes done-state {
      0%, 65%   { opacity:0; transform:scale(0.7); }
      71%       { opacity:1; transform:scale(1.08); }
      76%, 100% { opacity:1; transform:scale(1); }
    }
    @keyframes dl-toast {
      0%, 75%   { opacity:0; transform:translateY(14px); }
      81%       { opacity:1; transform:translateY(-2px); }
      86%, 100% { opacity:1; transform:translateY(0); }
    }

    /* ── Order Simulator: number pulse on recalc ── */
    .num-pulse {
      animation: numPulse 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes numPulse {
      0%   { transform:scale(1); color:inherit; }
      45%  { transform:scale(1.12); color:#006c49; }
      100% { transform:scale(1); color:inherit; }
    }

    /* ── Custom VAT checkbox ── */
    .vat-check {
      stroke-dasharray: 22;
      stroke-dashoffset: 22;
      transition: stroke-dashoffset 0.28s cubic-bezier(0.4,0,0.2,1);
    }
    input#sim-vat:checked ~ div .vat-check,
    .peer:checked + .vat-box .vat-check {
      stroke-dashoffset: 0;
    }

    /* Card hover border glow */
    .group:hover {
      border-color: rgba(0,55,176,0.2);
      box-shadow: 0 20px 40px rgba(0,55,176,0.08);
    }
  </style>
</Layout>
