---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173'
---

<Layout
  title="FIRS Tax Filing for Nigerian Freelancers & Small Businesses — Tari1"
  description="Generate your FIRS-ready annual tax summary in one click. Export a PDF for your accountant or a CSV of all deductible expenses. No spreadsheet wrangling required."
>
  <Navbar activePage="tax-filing" />

  <!-- Tax disclaimer banner -->
  <div class="w-full bg-amber-50 border-b border-amber-200 py-3 px-container-padding text-center text-xs text-amber-800 font-medium">
    Tari1 is invoicing and record-keeping software, not a licensed tax advisor. Consult a qualified tax professional for your filing obligations.
  </div>

  <main class="hero-gradient">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-16 md:py-32 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="stagger-in">
        <div class="inline-flex items-center gap-2 bg-[#ffddb8] text-[#121c28] text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full mb-6">
          Tax Filing Pack
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-[72px] leading-[1.1] font-bold text-primary tracking-tight mb-6">Tax filing without<br />the <span class="text-surface-tint">spreadsheet</span> pain</h1>
        <p class="text-base text-text-secondary mb-10 max-w-lg font-medium">Generate your FIRS-ready annual tax summary in one click. Export a PDF for your accountant or a CSV of all deductible expenses — no manual number crunching required.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-primary text-on-primary px-10 py-5 rounded-[12px] text-lg font-bold shadow-2xl shadow-primary/25 active:scale-95 btn-gradient pulse-primary">
            Start for free
          </a>
          <a href="/" class="w-full sm:w-auto text-center text-text-secondary px-8 py-5 rounded-[12px] text-base font-medium border border-outline-variant hover:border-primary transition-colors">
            See all features
          </a>
        </div>
      </div>
      <div class="relative w-full aspect-square md:aspect-[4/3] flex items-center justify-center min-h-[440px] md:min-h-[520px] stagger-in">
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-surface-container rounded-full blur-3xl opacity-50 -z-10"></div>
        <!-- Base Desktop Tax Filing Mockup (z-10) -->
        <div class="absolute left-0 top-4 w-[80%] z-10 rounded-[20px] border border-outline-variant/20 overflow-hidden shadow-2xl bg-surface-container-lowest transition-all hover:scale-[1.01] duration-500">
          <div class="flex items-center gap-1.5 px-4 py-3 bg-surface-container border-b border-outline-variant/10 shrink-0">
            <div class="flex gap-1">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
            </div>
            <div class="mx-auto bg-surface-container-lowest border border-outline-variant/10 rounded-md px-4 py-0.5 text-[10px] text-text-secondary select-none flex items-center gap-1.5 w-full max-w-[200px] justify-center truncate">
              <i class="hgi-stroke hgi-lock text-[8px] text-success"></i>
              app.tarione.com/tax
            </div>
          </div>
          <img alt="Tari1 Tax Filing Pack" class="w-full h-auto object-cover" src="/dashboard_tax.png">
        </div>
        <!-- Middle Human Layer (z-20) -->
        <div class="absolute right-0 bottom-4 w-[42%] z-20 overflow-hidden rounded-3xl border-4 border-white shadow-2xl bg-white aspect-[3/4]">
          <img alt="Car Dealer compliance" class="w-full h-full object-cover" src="/car_dealer_persona.png">
        </div>
        <!-- Glass Overlay Element (z-30) -->
        <div class="absolute bottom-12 -left-8 z-30 glass-card p-5 rounded-[24px] shadow-xl border border-white/20 max-w-[200px]">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-success/20 flex items-center justify-center text-success">
              <i class="hgi-stroke hgi-checkmark-circle-01 text-[20px]"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-text-primary">FIRS Return</p>
              <p class="text-[8px] text-text-secondary">VAT & WHT Ready</p>
            </div>
          </div>
          <p class="text-lg font-bold text-primary">Generated</p>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="bg-surface-container-low py-32">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-20 stagger-in">
          <h2 class="text-3xl font-extrabold text-primary mb-4">Tax season shouldn't be a crisis</h2>
          <p class="text-base text-text-secondary max-w-xl mx-auto">Most freelancers and small business owners scramble at year-end because their records are scattered. Tari1 keeps everything ready throughout the year.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-checkmark-circle-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">FIRS-ready tax summary</h3>
            <p class="text-sm text-text-secondary">Tari1 generates an annual tax summary formatted for FIRS requirements. Hand it to your accountant or file with their guidance — no reformatting needed.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-download-02 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Export PDF or CSV in one click</h3>
            <p class="text-sm text-text-secondary">Download a clean PDF to share with your accountant, or a CSV of all categorised expenses for your own records. Your data, your format.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-grid-02 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Deductible expenses automatically categorised</h3>
            <p class="text-sm text-text-secondary">Every expense you record through the year gets categorised. When it's time to file, Tari1 surfaces all your deductibles — so you never leave money on the table.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-calendar-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Ready year-round, not just in March</h3>
            <p class="text-sm text-text-secondary">Because Tari1 tracks income and expenses all year, your tax data is always up to date. No frantic reconciliation at year-end — just export and go.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="max-w-7xl mx-auto px-container-padding py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs uppercase tracking-widest text-text-secondary mb-12">Designed around Nigerian tax requirements</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div>
            <p class="text-4xl font-extrabold text-primary">1-click</p>
            <p class="mt-2 text-text-secondary text-sm">annual tax summary export</p>
          </div>
          <div>
            <p class="text-4xl font-extrabold text-primary">FIRS</p>
            <p class="mt-2 text-text-secondary text-sm">ready format out of the box</p>
          </div>
          <div>
            <p class="text-4xl font-extrabold text-primary">₦0</p>
            <p class="mt-2 text-text-secondary text-sm">to get started — no card needed</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-container-padding">
      <div class="max-w-5xl mx-auto bg-surface-container p-12 md:p-20 rounded-[48px] text-center shadow-xl border border-white/20">
        <h2 class="text-3xl font-extrabold text-primary mb-6">Get your taxes sorted this year</h2>
        <p class="text-base text-text-secondary mb-12 max-w-xl mx-auto">Start tracking today so year-end is painless. No debit card required.</p>
        <a href={`${appUrl}/register`} class="inline-block bg-primary text-on-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all btn-gradient">
          Get started free
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
