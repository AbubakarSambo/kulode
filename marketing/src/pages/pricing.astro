---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';
---

<Layout
  title="Simple, Transparent Pricing — Tari1"
  description="Simple, transparent pricing for the POS built for Nigerian restaurants. Start with a 30-day free trial, no credit card required."
>
  <Navbar activePage="pricing" />

  <main class="w-full pt-20 pb-20 font-sans bg-[#f8f9ff]">
    
    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto text-center px-container-padding mb-12 stagger-in">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-primary mb-6 leading-tight">
        Simple, Transparent Pricing
      </h1>
      <p class="text-lg md:text-xl text-text-secondary mb-10 max-w-2xl mx-auto font-medium">
        One plan, one price: ₦49,000 a month. Start with a 30-day free trial, no credit card required. Pay for more months at once and each month costs less.
      </p>

      <!-- Term selector -->
      <div class="flex justify-center">
        <div id="term-selector" role="radiogroup" aria-label="Billing term" class="bg-primary/10 p-1.5 rounded-3xl grid grid-cols-4 gap-1 w-full max-w-lg">
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-term
            data-period="MONTHLY"
            data-months="1"
            data-price="49000"
            data-list="49000"
            data-cycle="month"
            class="term-btn flex flex-col items-center justify-start gap-1 rounded-2xl px-1 py-2.5 min-h-[60px] text-sm font-bold transition-all duration-200 cursor-pointer text-text-secondary hover:text-primary"
          >
            <span class="whitespace-nowrap">1 month</span>
            <span class="term-badge rounded-md px-1.5 py-0.5 text-[9px] font-bold uppercase leading-tight tracking-wide text-center invisible">none</span>
          </button>
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-term
            data-period="QUARTERLY"
            data-months="3"
            data-price="139500"
            data-list="147000"
            data-cycle="3 months"
            class="term-btn flex flex-col items-center justify-start gap-1 rounded-2xl px-1 py-2.5 min-h-[60px] text-sm font-bold transition-all duration-200 cursor-pointer text-text-secondary hover:text-primary"
          >
            <span class="whitespace-nowrap">3 months</span>
            <span class="term-badge rounded-md px-1.5 py-0.5 text-[9px] font-bold uppercase leading-tight tracking-wide text-center bg-[#6ffbbe] text-[#006c49]">Save 5%</span>
          </button>
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-term
            data-period="BIANNUAL"
            data-months="6"
            data-price="264500"
            data-list="294000"
            data-cycle="6 months"
            class="term-btn flex flex-col items-center justify-start gap-1 rounded-2xl px-1 py-2.5 min-h-[60px] text-sm font-bold transition-all duration-200 cursor-pointer text-text-secondary hover:text-primary"
          >
            <span class="whitespace-nowrap">6 months</span>
            <span class="term-badge rounded-md px-1.5 py-0.5 text-[9px] font-bold uppercase leading-tight tracking-wide text-center bg-[#6ffbbe] text-[#006c49]">Save 10%</span>
          </button>
          <button
            type="button"
            role="radio"
            aria-checked="true"
            data-term
            data-period="ANNUAL"
            data-months="12"
            data-price="490000"
            data-list="588000"
            data-cycle="12 months"
            class="term-btn flex flex-col items-center justify-start gap-1 rounded-2xl px-1 py-2.5 min-h-[60px] text-sm font-bold transition-all duration-200 cursor-pointer bg-primary text-white shadow-md"
          >
            <span class="whitespace-nowrap">12 months</span>
            <span class="term-badge rounded-md px-1.5 py-0.5 text-[9px] font-bold uppercase leading-tight tracking-wide text-center bg-[#6ffbbe] text-[#006c49]">2 months free</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Pricing Card -->
    <section class="max-w-xl mx-auto px-container-padding mb-32">
      <div class="bg-white p-8 md:p-10 rounded-[32px] border-2 border-primary shadow-[0_20px_50px_rgba(0,55,176,0.1)] flex flex-col justify-between stagger-in">
        <div>
          <h3 class="text-lg font-bold text-text-primary mb-2">Pro Plan</h3>
          <p class="text-xs text-text-secondary mb-8 font-medium">Everything you need to run your floor, your team and your stock.</p>
          <div class="mb-8" aria-live="polite">
            <div class="flex flex-wrap items-baseline gap-x-3">
              <span id="price-total" class="text-4xl md:text-5xl font-bold text-primary tracking-tight">₦490,000</span>
              <span id="price-list" class="text-base text-text-secondary/70 font-semibold line-through">₦588,000</span>
            </div>
            <p id="price-sub" class="text-xs text-text-secondary font-semibold mt-2">₦40,833 per month · billed ₦490,000 every 12 months</p>
          </div>

          <ul class="space-y-4 mb-6 text-sm text-text-secondary font-medium">
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Up to 20 active users</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Tableside order taking</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Table & floor management</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Live kitchen display</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Shift & cash reconciliation</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Sales dashboard & item reports</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Waiters, order & payment types</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Inventory & stock tracking</span>
              </li>
              <li class="flex items-center gap-3 hover:translate-x-1 transition-transform duration-200">
                <i class="hgi-stroke hgi-checkmark-circle-02 text-primary text-xl"></i>
                <span>Customer wallets & store credit</span>
              </li>
            <li class="flex items-start gap-3 text-primary font-bold bg-[#eef4ff] p-4 rounded-2xl transition-all duration-300 hover:shadow-inner">
              <i class="hgi-stroke hgi-sparkles text-primary text-2xl shrink-0 mt-0.5 animate-pulse"></i>
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-primary">AI Business Chat</p>
                <p class="text-xs text-text-secondary font-medium leading-relaxed mt-1">Ask about sales, orders, shifts, or customers in plain English and get instant dashboards back.</p>
              </div>
            </li>
            <li class="flex items-start gap-3 text-primary font-bold bg-[#eef4ff] p-4 rounded-2xl transition-all duration-300 hover:shadow-inner">
              <i class="hgi-stroke hgi-checkmark-badge-01 text-primary text-2xl shrink-0 mt-0.5 animate-pulse"></i>
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-primary">Offline-first ordering</p>
                <p class="text-xs text-text-secondary font-medium leading-relaxed mt-1">Orders keep flowing through network drops and sync automatically once you're back online.</p>
              </div>
            </li>
          </ul>
        </div>
        <a href={`${appUrl}/register`} class="w-full text-center py-4 rounded-[12px] bg-primary text-white text-sm font-bold shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 active:scale-95 transition-all duration-200 btn-gradient">
          Start Free Trial
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-3xl mx-auto px-container-padding stagger-in">
      <h2 class="text-3xl font-bold text-primary mb-10 text-center">Frequently Asked Questions</h2>
      
      <div class="space-y-4">
        <!-- FAQ 1 -->
        <div class="bg-white rounded-2xl border-0 p-6 hover:shadow-md transition-all duration-200 cursor-pointer faq-item shadow-[0_12px_32px_rgba(0,55,176,0.015)]">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-text-primary text-base">Can I change plans at any time?</h4>
            <i class="hgi-stroke hgi-plus-sign text-primary toggle-icon transition-transform duration-300"></i>
          </div>
          <p class="text-sm text-text-secondary mt-4 hidden leading-relaxed transition-all duration-300">
            Yes. Choose 1, 3, 6 or 12 months from the Billing panel in your Settings tab, and cancel there whenever you like. A cancellation takes effect at the end of the period you have already paid for.
          </p>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-white rounded-2xl border-0 p-6 hover:shadow-md transition-all duration-200 cursor-pointer faq-item shadow-[0_12px_32px_rgba(0,55,176,0.015)]">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-text-primary text-base">How does the 30-day trial work?</h4>
            <i class="hgi-stroke hgi-plus-sign text-primary toggle-icon transition-transform duration-300"></i>
          </div>
          <p class="text-sm text-text-secondary mt-4 hidden leading-relaxed transition-all duration-300">
            When you register, you automatically start on a 30-day free trial. No credit card is required to join. If you choose not to subscribe after 30 days, your account will be temporarily locked until you select a paid plan to continue.
          </p>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-white rounded-2xl border-0 p-6 hover:shadow-md transition-all duration-200 cursor-pointer faq-item shadow-[0_12px_32px_rgba(0,55,176,0.015)]">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-text-primary text-base">Are payments through Paystack secure?</h4>
            <i class="hgi-stroke hgi-plus-sign text-primary toggle-icon transition-transform duration-300"></i>
          </div>
          <p class="text-sm text-text-secondary mt-4 hidden leading-relaxed transition-all duration-300">
            Yes. All online card, bank transfer, and USSD payments are initialized and processed directly on Paystack's PCI-DSS compliant gateways. TariOne never stores your clients' card numbers or credentials.
          </p>
        </div>

        <!-- FAQ 4 -->
        <div class="bg-white rounded-2xl border-0 p-6 hover:shadow-md transition-all duration-200 cursor-pointer faq-item shadow-[0_12px_32px_rgba(0,55,176,0.015)]">
          <div class="flex justify-between items-center">
            <h4 class="font-bold text-text-primary text-base">What can the AI Business Chat actually answer?</h4>
            <i class="hgi-stroke hgi-plus-sign text-primary toggle-icon transition-transform duration-300"></i>
          </div>
          <p class="text-sm text-text-secondary mt-4 hidden leading-relaxed transition-all duration-300">
            Ask it about sales trends, best-selling menu items, order history, shift till reconciliation, or your most loyal customers — in plain English. It reads your live business data and answers with a summary plus generated charts and tables, no report-building required.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer contactEmail="support@tarione.com" />

  <script>
    // Intersection Observer for scroll animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = 'running';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.stagger-in').forEach(el => {
      (el as HTMLElement).style.animationPlayState = 'paused';
      observer.observe(el);
    });

    // Billing term selector
    const naira = (n: number) => '\u20A6' + Math.round(n).toLocaleString('en-NG');
    const termButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-term]'));
    const totalEl = document.getElementById('price-total');
    const listEl = document.getElementById('price-list');
    const subEl = document.getElementById('price-sub');
    const activeClasses = ['bg-primary', 'text-white', 'shadow-md'];
    const idleClasses = ['text-text-secondary', 'hover:text-primary'];

    function selectTerm(btn: HTMLButtonElement) {
      const months = Number(btn.dataset.months);
      const price = Number(btn.dataset.price);
      const list = Number(btn.dataset.list);

      termButtons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-checked', String(on));
        activeClasses.forEach((c) => b.classList.toggle(c, on));
        idleClasses.forEach((c) => b.classList.toggle(c, !on));
      });

      if (totalEl) totalEl.textContent = naira(price);
      if (listEl) {
        listEl.textContent = naira(list);
        listEl.classList.toggle('hidden', price >= list);
      }
      if (subEl) {
        subEl.textContent = months > 1
          ? `${naira(price / months)} per month \u00B7 billed ${naira(price)} every ${btn.dataset.cycle}`
          : 'Billed monthly';
      }
    }

    termButtons.forEach((btn) => btn.addEventListener('click', () => selectTerm(btn)));

    // FAQ Accordion click toggles
    document.querySelectorAll('.faq-item').forEach(item => {
      item.addEventListener('click', () => {
        const desc = item.querySelector('p');
        const icon = item.querySelector('.toggle-icon');
        
        if (desc) {
          if (desc.classList.contains('hidden')) {
            desc.classList.remove('hidden');
            desc.classList.add('animate-slide-down');
            if (icon) {
              icon.classList.remove('hgi-stroke', 'hgi-plus-sign');
              icon.classList.add('hgi-stroke', 'hgi-minus-sign');
              icon.classList.add('rotate-180');
            }
          } else {
            desc.classList.add('hidden');
            desc.classList.remove('animate-slide-down');
            if (icon) {
              icon.classList.remove('hgi-stroke', 'hgi-minus-sign', 'rotate-180');
              icon.classList.add('hgi-stroke', 'hgi-plus-sign');
            }
          }
        }
      });
    });
  </script>
</Layout>
