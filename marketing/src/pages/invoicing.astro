---
import Layout from '../layouts/Layout.astro'

const appUrl = 'http://localhost:5173'
---

<Layout
  title="Online Invoicing Software for Nigerian Businesses — Kulode"
  description="Create and send professional invoices in seconds. Accept payments via Paystack, track payment status, and send automatic reminders. Built for Nigerian freelancers and small businesses."
>
  <!-- Nav -->
  <nav class="w-full sticky top-0 z-50 bg-background/80 backdrop-blur-xl shadow-[0_12px_32px_rgba(0,55,176,0.08)]">
    <div class="flex justify-between items-center px-container-padding max-w-7xl mx-auto h-[72px]">
      <div class="flex items-center gap-12">
        <a href="/" class="text-[24px] font-extrabold tracking-tighter text-primary">Kulode</a>
        <div class="hidden md:flex items-center gap-8">
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/#features">Features</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/how-it-works">How It Works</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/pricing">Pricing</a>
          <a class="text-sm text-primary font-bold border-b-2 border-primary hover:text-primary transition-colors duration-200" href="/invoicing">Solutions</a>
          <a class="text-sm text-text-secondary hover:text-primary transition-colors duration-200" href="/tax-filing">Tax Filing</a>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href={`${appUrl}/login`} class="text-sm font-medium text-text-secondary px-6 py-2 transition-all hover:text-primary active:scale-95">Login</a>
        <a href={`${appUrl}/register`} class="bg-primary text-on-primary px-6 py-3 rounded-[12px] text-sm font-bold shadow-lg shadow-primary/20 hover:shadow-xl transition-all active:scale-95 btn-gradient">Get Started</a>
      </div>
    </div>
  </nav>

  <main class="hero-gradient">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-container-padding py-20 md:py-32 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="stagger-in">
        <div class="inline-flex items-center gap-2 bg-[#ffddb8] text-[#121c28] text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full mb-6">
          Invoicing
        </div>
        <h1 class="text-[56px] md:text-[72px] leading-[1.1] font-extrabold text-primary tracking-tight mb-6">Send invoices.<br />Get paid <span class="text-surface-tint">faster</span>.</h1>
        <p class="text-base text-text-secondary mb-10 max-w-lg">Create professional invoices in seconds, share a payment link, and get paid via Paystack — directly from your invoice. No chasing, no spreadsheets.</p>
        <div class="flex flex-col sm:flex-row gap-4 items-center">
          <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-primary text-on-primary px-10 py-5 rounded-[12px] text-lg font-bold shadow-2xl shadow-primary/25 active:scale-95 btn-gradient pulse-primary">
            Start invoicing free
          </a>
          <a href="/" class="w-full sm:w-auto text-center text-text-secondary px-8 py-5 rounded-[12px] text-base font-medium border border-outline-variant hover:border-primary transition-colors">
            See all features
          </a>
        </div>
      </div>
      <div class="relative w-full aspect-square md:aspect-[4/3] flex items-center justify-center min-h-[440px] md:min-h-[520px] stagger-in">
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-surface-container rounded-full blur-3xl opacity-50 -z-10"></div>
        <!-- Base Desktop Invoice Creator Mockup (z-10) -->
        <div class="absolute left-0 top-4 w-[78%] z-10 rounded-[20px] border border-outline-variant/20 overflow-hidden shadow-2xl bg-surface-container-lowest transition-all hover:scale-[1.01] duration-500">
          <div class="flex items-center gap-1.5 px-4 py-3 bg-surface-container border-b border-outline-variant/10 shrink-0">
            <div class="flex gap-1">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
            </div>
            <div class="mx-auto bg-surface-container-lowest border border-outline-variant/10 rounded-md px-4 py-0.5 text-[10px] text-text-secondary select-none flex items-center gap-1.5 w-full max-w-[200px] justify-center truncate">
              <i class="hgi-stroke hgi-lock text-[8px] text-success"></i>
              app.kulode.com/invoices/new
            </div>
          </div>
          <img alt="Kulode Invoice Creator" class="w-full h-auto object-cover" src="/media__1780774031554.png">
        </div>
        <!-- Middle Human Layer (z-20) -->
        <div class="absolute right-0 bottom-4 w-[42%] z-20 overflow-hidden rounded-3xl border-4 border-white shadow-2xl bg-white aspect-[3/4]">
          <img alt="Social Merchant Invoicing" class="w-full h-full object-cover" src="/social_merchant_persona.png">
        </div>
        <!-- Foreground Mobile Mockup (z-30) -->
        <div class="absolute right-[36%] -bottom-4 w-[24%] z-30 rounded-[28px] border-[6px] border-slate-900 overflow-hidden shadow-2xl bg-slate-900 aspect-[9/16] hidden sm:block">
          <img alt="Mobile Payment Checkout" class="w-full h-full object-cover" src="/media__1780774065042.png">
        </div>
        <!-- Glass Overlay Element (z-30) -->
        <div class="absolute bottom-12 -left-8 z-30 glass-card p-5 rounded-[24px] shadow-xl border border-white/20 max-w-[200px]">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-8 h-8 rounded-full bg-success/20 flex items-center justify-center text-success">
              <i class="hgi-stroke hgi-checkmark-circle-01 text-[20px]"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-text-primary">Invoice Shared</p>
              <p class="text-[8px] text-text-secondary">WhatsApp DM</p>
            </div>
          </div>
          <p class="text-lg font-bold text-primary">Delivered</p>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="bg-surface-container-low py-32">
      <div class="max-w-7xl mx-auto px-container-padding">
        <div class="text-center mb-20 stagger-in">
          <h2 class="text-3xl font-extrabold text-primary mb-4">Everything you need to get paid</h2>
          <p class="text-base text-text-secondary max-w-xl mx-auto">Kulode handles the full invoicing flow — from creation to payment to follow-up.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-pencil-edit-02 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Professional invoices in seconds</h3>
            <p class="text-sm text-text-secondary">Fill in your client, line items, and due date — Kulode generates a clean, branded invoice ready to send. No design skills needed.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-credit-card text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Online payments via Paystack</h3>
            <p class="text-sm text-text-secondary">Every invoice includes a payment link. Your client clicks, pays with card or bank transfer — and you're notified instantly. No separate payment setup required.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-notification-03 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Automatic payment reminders</h3>
            <p class="text-sm text-text-secondary">Stop chasing clients manually. Kulode sends payment reminders on your behalf — so you stay professional while the follow-up happens automatically.</p>
          </div>

          <div class="bg-surface-container-lowest p-10 rounded-[24px] shadow-[0_12px_32px_rgba(0,55,176,0.04)] hover:shadow-[0_20px_40px_rgba(0,55,176,0.10)] hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 bg-primary/5 rounded-[16px] flex items-center justify-center text-primary mb-8">
              <i class="hgi-stroke hgi-analytics-01 text-[32px]"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-4">Track payment status at a glance</h3>
            <p class="text-sm text-text-secondary">See which invoices are paid, pending, or overdue — all in one dashboard. Know exactly where your money stands without digging through your inbox.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Strip -->
    <section class="max-w-7xl mx-auto px-container-padding py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs uppercase tracking-widest text-text-secondary mb-12">Built for Nigerian freelancers & small businesses</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div>
            <p class="text-4xl font-extrabold text-primary">60s</p>
            <p class="mt-2 text-text-secondary text-sm">to create your first invoice</p>
          </div>
          <div>
            <p class="text-4xl font-extrabold text-primary">₦0</p>
            <p class="mt-2 text-text-secondary text-sm">to get started — no card needed</p>
          </div>
          <div>
            <p class="text-4xl font-extrabold text-primary">Paystack</p>
            <p class="mt-2 text-text-secondary text-sm">payments built in</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-container-padding">
      <div class="max-w-5xl mx-auto bg-surface-container p-12 md:p-20 rounded-[48px] text-center shadow-xl border border-white/20">
        <h2 class="text-3xl font-extrabold text-primary mb-6">Start sending invoices today</h2>
        <p class="text-base text-text-secondary mb-12 max-w-xl mx-auto">Create your account in under a minute. No debit card required.</p>
        <a href={`${appUrl}/register`} class="inline-block bg-primary text-on-primary px-12 py-5 rounded-[12px] text-base font-bold shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all btn-gradient">
          Get started free
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full py-12 bg-surface border-t border-outline-variant">
    <div class="flex flex-col md:flex-row justify-between items-center gap-element-gap px-container-padding max-w-7xl mx-auto">
      <div class="flex flex-col gap-4 items-center md:items-start">
        <span class="text-2xl font-bold tracking-tight text-primary">Kulode</span>
        <p class="text-sm text-text-secondary text-center md:text-left max-w-xs">
          © {new Date().getFullYear()} Kulode. All rights reserved. Built for the modern freelancer.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-8">
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/privacy">Privacy Policy</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/terms">Terms of Service</a>
        <a class="text-sm text-text-secondary hover:text-primary transition-all" href="mailto:abubakar.sambo@kulode.app">Contact Support</a>
      </div>
    </div>
  </footer>
</Layout>
