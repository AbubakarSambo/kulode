---
import Layout from '../layouts/Layout.astro'

const appUrl = 'https://app.kulode.com'
---

<Layout
  title="Online Invoicing Software for Nigerian Businesses — Kulode"
  description="Create and send professional invoices in seconds. Accept payments via Paystack, track payment status, and send automatic reminders. Built for Nigerian freelancers and small businesses."
>
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight text-gray-900">kulode</a>
      <div class="flex items-center gap-4">
        <a href={`${appUrl}/login`} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Log in</a>
        <a href={`${appUrl}/register`} class="text-sm font-medium bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800 transition-colors">Get started free</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 text-sm font-medium px-3 py-1.5 rounded-full mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
        Invoicing
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-900 leading-tight">
        Send invoices.<br />Get paid faster.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Create professional invoices in seconds, share a payment link, and get paid via Paystack — directly from your invoice. No chasing, no spreadsheets.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${appUrl}/register`} class="w-full sm:w-auto text-center bg-blue-700 text-white px-8 py-3.5 rounded-lg text-base font-medium hover:bg-blue-800 transition-colors">
          Start invoicing free
        </a>
        <a href="/" class="w-full sm:w-auto text-center text-gray-600 px-8 py-3.5 rounded-lg text-base font-medium border border-gray-200 hover:border-gray-300 hover:text-gray-900 transition-colors">
          See all features
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Everything you need to get paid</h2>
        <p class="mt-4 text-lg text-gray-500 max-w-xl mx-auto">Kulode handles the full invoicing flow — from creation to payment to follow-up.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl p-8 border border-gray-100">
          <div class="w-10 h-10 rounded-lg bg-blue-700 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Professional invoices in seconds</h3>
          <p class="text-gray-500 leading-relaxed">Fill in your client, line items, and due date — Kulode generates a clean, branded invoice ready to send. No design skills needed.</p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-gray-100">
          <div class="w-10 h-10 rounded-lg bg-blue-700 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Online payments via Paystack</h3>
          <p class="text-gray-500 leading-relaxed">Every invoice includes a payment link. Your client clicks, pays with card or bank transfer — and you're notified instantly. No separate payment setup required.</p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-gray-100">
          <div class="w-10 h-10 rounded-lg bg-blue-700 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Automatic payment reminders</h3>
          <p class="text-gray-500 leading-relaxed">Stop chasing clients manually. Kulode sends payment reminders on your behalf — so you stay professional while the follow-up happens automatically.</p>
        </div>

        <div class="bg-white rounded-xl p-8 border border-gray-100">
          <div class="w-10 h-10 rounded-lg bg-blue-700 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Track payment status at a glance</h3>
          <p class="text-gray-500 leading-relaxed">See which invoices are paid, pending, or overdue — all in one dashboard. Know exactly where your money stands without digging through your inbox.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof / trust strip -->
  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-gray-400 text-sm font-medium uppercase tracking-widest mb-8">Built for Nigerian freelancers & small businesses</p>
      <div class="grid sm:grid-cols-3 gap-8">
        <div>
          <p class="text-3xl font-bold text-gray-900">60s</p>
          <p class="mt-1 text-gray-500 text-sm">to create your first invoice</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-gray-900">₦0</p>
          <p class="mt-1 text-gray-500 text-sm">to get started — no card needed</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-gray-900">Paystack</p>
          <p class="mt-1 text-gray-500 text-sm">payments built in</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Start sending invoices today</h2>
      <p class="mt-4 text-lg text-gray-500">Create your account in under a minute. No debit card required.</p>
      <a href={`${appUrl}/register`} class="mt-8 inline-block bg-blue-700 text-white px-8 py-3.5 rounded-lg text-base font-medium hover:bg-blue-800 transition-colors">
        Get started free
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-sm text-gray-400">&copy; {new Date().getFullYear()} Kulode. All rights reserved.</span>
      <div class="flex items-center gap-6">
        <a href="mailto:abubakar.sambo@kulode.com" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Contact</a>
        <a href="/privacy" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Privacy</a>
        <a href="/terms" class="text-sm text-gray-400 hover:text-gray-600 transition-colors">Terms</a>
      </div>
    </div>
  </footer>
</Layout>
