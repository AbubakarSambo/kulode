---
---
<div id="rebrand-banner" class="hidden bg-[#0037b0] text-white px-4 py-2 items-center justify-between text-sm sm:text-base z-50">
  <div class="flex items-center gap-2 max-w-4xl mx-auto w-full justify-center text-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-80"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
    <p class="font-medium">
      <span class="font-bold">Kulode is now Tari1.</span> In the coming weeks, our web address will automatically update to reflect our new brand.
    </p>
  </div>
  <button 
    id="dismiss-rebrand-banner"
    class="shrink-0 p-1 rounded-full hover:bg-white/20 transition-colors focus:outline-none"
    aria-label="Dismiss banner"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</div>

<script>
  function setupRebrandBanner() {
    const banner = document.getElementById('rebrand-banner');
    const dismissBtn = document.getElementById('dismiss-rebrand-banner');
    
    if (!banner || !dismissBtn) return;
    
    const endDate = new Date('2026-07-12T00:00:00Z');
    const isDismissed = localStorage.getItem('tari1-rebrand-banner-dismissed') === 'true';
    
    if (new Date() < endDate && !isDismissed) {
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
    
    dismissBtn.addEventListener('click', () => {
      localStorage.setItem('tari1-rebrand-banner-dismissed', 'true');
      banner.classList.add('hidden');
      banner.classList.remove('flex');
    });
  }

  // Run on initial load
  setupRebrandBanner();
  
  // Astro view transitions support
  document.addEventListener('astro:page-load', setupRebrandBanner);
</script>
