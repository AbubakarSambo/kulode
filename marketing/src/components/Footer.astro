---
import clientPkg from '../../../client/package.json';

interface Props {
  contactEmail?: string;
}

const { contactEmail = 'abubakar.sambo@tarione.com' } = Astro.props;
---

<footer class="w-full py-12 bg-surface border-t border-outline-variant">
  <div class="flex flex-col md:flex-row justify-between items-center gap-element-gap px-container-padding max-w-7xl mx-auto">
    <div class="flex flex-col gap-4 items-center md:items-start">
      <span class="text-2xl font-bold tracking-tight text-primary">Tari1</span>
      <p class="text-sm text-text-secondary text-center md:text-left max-w-xs">
        © {new Date().getFullYear()} Tari1. All rights reserved. Built for Nigerian small businesses, freelancers, and DNFBPs.
      </p>
      <p class="text-xs text-text-secondary text-center md:text-left">
        Lagos, Nigeria · <a href={`mailto:${contactEmail}`} class="hover:text-primary transition-colors">{contactEmail}</a> · <span class="font-mono text-[10px] bg-slate-100 text-slate-650 px-1.5 py-0.5 rounded">v{clientPkg.version}</span>
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-8">
      <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/privacy">Privacy Policy</a>
      <a class="text-sm text-text-secondary hover:text-primary transition-all" href="/terms">Terms of Service</a>
      <a class="text-sm text-text-secondary hover:text-primary transition-all" href="mailto:abubakar.sambo@tarione.com">Contact Support</a>
    </div>
  </div>
</footer>
