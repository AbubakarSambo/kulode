generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  PAYSTACK
  OTHER
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_SETUP
  PASSWORD_RESET
}

enum StockMovementType {
  RESTOCK
  ADJUSTMENT
  INVOICE_RESERVED
  INVOICE_DEDUCTED
  RESERVATION_RELEASED
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum TaxCategory {
  RENT
  SALARIES
  UTILITIES
  MARKETING
  TRANSPORT
  PROFESSIONAL_FEES
  LOAN_INTEREST
  CAPITAL_ASSETS
  NON_DEDUCTIBLE
  UNCATEGORIZED
}

enum PaystackSubaccountStatus {
  PENDING
  ACTIVE
  FAILED
}

// Organizations (tenants)
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  logo      String?
  rcNumber  String?  @map("rc_number")
  tin       String?  @map("tin")

  // Paystack integration
  paystackSubaccountCode String?  @map("paystack_subaccount_code")
  bankCode               String?  @map("bank_code")
  bankAccountNumber      String?  @map("bank_account_number")
  bankAccountName        String?  @map("bank_account_name")
  settlementBank         String?  @map("settlement_bank")
  isPaystackVerified     Boolean  @default(false) @map("is_paystack_verified")
  
  // Platform settings
  platformFeePercent     Decimal  @default(0.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  invoicePrefix          String   @default("INV") @map("invoice_prefix")
  currency               String   @default("NGN")
  taxRate                Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  vatEnabled             Boolean  @default(false) @map("vat_enabled")
  showQrCode             Boolean  @default(false) @map("show_qr_code")
  paymentTerms           String?  @map("payment_terms")
  defaultNotes           String?  @map("default_notes")
  businessType           String?  @map("business_type")
  organizationSize       String?  @map("organization_size")
  onboardingDismissedAt  DateTime? @map("onboarding_dismissed_at")
  clientReminderSentAt   DateTime? @map("client_reminder_sent_at")

  // Subscription
  planTier              PlanTier           @default(FREE) @map("plan_tier")
  subscriptionStatus    SubscriptionStatus @default(TRIALING) @map("subscription_status")
  billingPeriod         BillingPeriod?     @map("billing_period")
  trialStartDate        DateTime?          @map("trial_start_date")
  trialEndDate          DateTime?          @map("trial_end_date")
  subscriptionStartDate DateTime?          @map("subscription_start_date")
  subscriptionEndDate   DateTime?          @map("subscription_end_date")
  paystackCustomerCode      String?            @map("paystack_customer_code")
  paystackAuthorizationCode String?            @map("paystack_authorization_code")
  paystackBillingEmail      String?            @map("paystack_billing_email")
  paystackCardLast4         String?            @map("paystack_card_last4")
  paystackCardType          String?            @map("paystack_card_type")
  autoRenew                 Boolean            @default(true) @map("auto_renew")
  isGrandfathered           Boolean            @default(false) @map("is_grandfathered")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users                User[]
  clients              Client[]
  invoices             Invoice[]
  payments             Payment[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  serviceItems         ServiceItem[]
  vendors              Vendor[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  subscriptionPayments SubscriptionPayment[]
  taxReportLogs        TaxReportLog[]
  chatSessions         ChatSession[]
  whatsappMessages     WhatsappMessage[]
  directors            OrganizationDirector[]

  @@map("organizations")
}

// Users
model User {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  role            UserRole @default(STAFF)
  businessRole    String?  @map("business_role")
  isActive        Boolean  @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  googleId        String?  @unique @map("google_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdInvoices    Invoice[]              @relation("CreatedByUser")
  recordedPayments   Payment[]              @relation("RecordedByUser")
  recordedExpenses   Expense[]              @relation("RecordedByUser")
  verificationTokens EmailVerificationToken[]
  taxReportLogs      TaxReportLog[]
  chatSessions       ChatSession[]

  @@index([organizationId])
  @@map("users")
}

// Email verification and password setup tokens
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Clients (customers of the organization)
model Client {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean @default(true) @map("is_active")
  clientType     String? @default("business") @map("client_type")

  // WhatsApp Business API consent (self-attested by the org, required before API-driven messaging)
  whatsappOptIn   Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt DateTime? @map("whatsapp_opt_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  whatsappMessages WhatsappMessage[]

  @@index([organizationId])
  @@map("clients")
}

// CAC-registered directors (CAMA 2020 s.304 compliance) — shown on invoices, no app login required
model OrganizationDirector {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")

  forenames     String
  surname       String
  formerName    String?  @map("former_name")
  isNonNigerian Boolean  @default(false) @map("is_non_nigerian")
  nationality   String?
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_directors")
}

// Invoices
model Invoice {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  clientId        String        @map("client_id")
  createdById     String        @map("created_by")
  
  invoiceNumber   String        @map("invoice_number")
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  
  subtotal        Decimal       @db.Decimal(12, 2)
  discountType    String        @default("PERCENTAGE") @map("discount_type")
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  
  notes           String?
  terms           String?
  
  // Paystack payment link
  paystackReference        String?   @unique @map("paystack_reference")
  paystackAccessCode       String?   @map("paystack_access_code")
  paymentUrl               String?   @map("payment_url")
  paystackTokenGeneratedAt DateTime? @map("paystack_token_generated_at")
  paystackPaidAt           DateTime? @map("paystack_paid_at")
  paystackChannel          String?   @map("paystack_channel")
  
  // Attached image (e.g. signed document, proof of work)
  imageUrl           String?   @map("image_url")

  // Public sharing
  shareToken         String?   @unique @map("share_token")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client               @relation(fields: [clientId], references: [id])
  createdBy        User                 @relation("CreatedByUser", fields: [createdById], references: [id])
  items            InvoiceItem[]
  payments         Payment[]
  installments     PaymentInstallment[]
  whatsappMessages WhatsappMessage[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

// Payment installments for staged payments
model PaymentInstallment {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  
  label       String  // e.g., "First Payment", "Final Payment"
  sequence    Int     // Order of installment (1, 2, 3...)
  percentage  Decimal? @db.Decimal(5, 2) // If percentage-based
  amount      Decimal  @db.Decimal(12, 2) // Calculated or fixed amount
  
  // Payment status
  isPaid      Boolean  @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  
  // Paystack payment link for this installment
  paystackReference        String?   @unique @map("paystack_reference")
  paystackAccessCode       String?   @map("paystack_access_code")
  paymentUrl               String?   @map("payment_url")
  paystackTokenGeneratedAt DateTime? @map("paystack_token_generated_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
  @@map("payment_installments")
}

// Invoice line items
model InvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String  @map("invoice_id")
  serviceItemId   String? @map("service_item_id")
  inventoryItemId String? @map("inventory_item_id")
  description     String
  quantity        Decimal @db.Decimal(10, 2)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem?   @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceItemId])
  @@index([inventoryItemId])
  @@map("invoice_items")
}

// Payments
model Payment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  invoiceId      String        @map("invoice_id")
  recordedById   String?       @map("recorded_by")
  
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentDate    DateTime      @map("payment_date") @db.Date
  reference      String?
  notes          String?
  
  // Auto-recorded via webhook
  isAutoRecorded    Boolean  @default(false) @map("is_auto_recorded")
  paystackReference String?  @map("paystack_reference")
  paystackFees      Decimal? @map("paystack_fees") @db.Decimal(12, 2)
  platformFees      Decimal? @map("platform_fees") @db.Decimal(12, 2)
  netAmount         Decimal? @map("net_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  recordedBy   User?        @relation("RecordedByUser", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

// Expense categories
model ExpenseCategory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

// Expenses
model Expense {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  categoryId     String?       @map("category_id")
  vendorId       String?       @map("vendor_id")
  recordedById   String        @map("recorded_by")

  description    String
  amount         Decimal       @db.Decimal(12, 2)
  expenseDate    DateTime      @map("expense_date") @db.Date
  recipient      String?
  paymentMethod  PaymentMethod @map("payment_method")
  reference      String?
  notes          String?
  taxCategory    TaxCategory   @default(UNCATEGORIZED) @map("tax_category")
  isDeductible   Boolean       @default(true) @map("is_deductible")

  // Auto-recorded via vendor payout webhook
  isAutoRecorded    Boolean  @default(false) @map("is_auto_recorded")
  paystackReference String?  @unique @map("paystack_reference")
  paystackFees      Decimal? @map("paystack_fees") @db.Decimal(12, 2)
  netAmount         Decimal? @map("net_amount") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  vendor       Vendor?          @relation(fields: [vendorId], references: [id])
  recordedBy   User             @relation("RecordedByUser", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([expenseDate])
  @@map("expenses")
}

// Service items (predefined products/services for invoices)
model ServiceItem {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_items")
}

// Inventory items (physical goods with stock tracking)
model InventoryItem {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  name             String
  description      String?
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  onHandQuantity   Decimal @default(0) @map("on_hand_quantity") @db.Decimal(10, 2)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(10, 2)
  reorderLevel     Decimal @default(0) @map("reorder_level") @db.Decimal(10, 2)
  sku              String?
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inventory_items")
}

// Stock movement log
model StockMovement {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  inventoryItemId String            @map("inventory_item_id")
  invoiceId       String?           @map("invoice_id")
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 2)
  onHandBefore    Decimal           @map("on_hand_before") @db.Decimal(10, 2)
  onHandAfter     Decimal           @map("on_hand_after") @db.Decimal(10, 2)
  notes           String?
  createdById     String?           @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@map("stock_movements")
}

// Vendors (external service providers/suppliers)
model Vendor {
  id                String  @id @default(uuid())
  organizationId    String  @map("organization_id")
  name              String
  serviceDescription String? @map("service_description")
  contactPerson     String? @map("contact_person")
  phone             String?
  email             String?
  bankAccountNumber String? @map("bank_account_number")
  bankName          String? @map("bank_name")
  isActive          Boolean @default(true) @map("is_active")

  // Paystack payout integration
  bankCode                 String?                   @map("bank_code")
  isBankVerified           Boolean                   @default(false) @map("is_bank_verified")
  paystackSubaccountCode   String?                   @map("paystack_subaccount_code")
  paystackSubaccountStatus PaystackSubaccountStatus? @map("paystack_subaccount_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("vendors")
}

// Subscription payments (separate from invoice payments)
model SubscriptionPayment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  billingPeriod     BillingPeriod @map("billing_period")
  planTier          PlanTier      @map("plan_tier")
  paystackReference String        @unique @map("paystack_reference")
  status            String        @default("success")
  paidAt            DateTime      @map("paid_at")
  periodStart       DateTime      @map("period_start")
  periodEnd         DateTime      @map("period_end")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("subscription_payments")
}

// Tax report generation audit log
model TaxReportLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  generatedAt    DateTime @default(now()) @map("generated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_report_logs")
}

// Shortened links mapping table
model ShortLink {
  id        String    @id @default(uuid())
  slug      String    @unique
  targetUrl String    @map("target_url")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@map("short_links")
}

model ChatSession {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  userId         String        @map("user_id")
  title          String
  isPinned       Boolean       @default(false) @map("is_pinned")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@index([organizationId, userId])
  @@index([deletedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id             String      @id @default(uuid())
  sessionId      String      @map("session_id")
  role           String      // "user" | "assistant"
  content        String
  layout         Json?       // Optional JSON layout representing dynamic UI components
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// Outbound WhatsApp Business API messages (invoice reminders, etc.)
model WhatsappMessage {
  id                String                @id @default(uuid())
  organizationId    String                @map("organization_id")
  invoiceId         String?               @map("invoice_id")
  clientId          String?               @map("client_id")
  templateName      String                @map("template_name")
  toPhone           String                @map("to_phone")
  status            WhatsappMessageStatus @default(PENDING)
  providerMessageId String?               @unique @map("provider_message_id")
  errorMessage      String?               @map("error_message")
  errorCode         String?               @map("error_code")
  sentAt            DateTime?             @map("sent_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("whatsapp_messages")
}


