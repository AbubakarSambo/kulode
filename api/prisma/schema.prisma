generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
  // POS-only-org roles — STAFF/ACCOUNTANT don't apply there; see api/src/common/decorators/roles.decorator.ts.
  MANAGER
  SUPERVISOR
  CASHIER
  WAITER
  PASS
  RUNNER
}

// Which feature modules an organization has access to. Distinct from
// `businessType` (a free-text personalization category) — this is the
// switch that gates the POS and Invoicing nav groups/routes.
enum OrgModule {
  POS
  INVOICING
  BOTH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  PAYSTACK
  WALLET
  OTHER
}

enum WalletTransactionType {
  TOPUP
  ORDER_DEBIT
  REFUND
  ADJUSTMENT
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_SETUP
  PASSWORD_RESET
}

enum StockMovementType {
  RESTOCK
  ADJUSTMENT
  INVOICE_RESERVED
  INVOICE_DEDUCTED
  RESERVATION_RELEASED
  ORDER_DEDUCTED
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum TaxCategory {
  RENT
  SALARIES
  UTILITIES
  MARKETING
  TRANSPORT
  PROFESSIONAL_FEES
  LOAN_INTEREST
  CAPITAL_ASSETS
  NON_DEDUCTIBLE
  UNCATEGORIZED
}

enum PaystackSubaccountStatus {
  PENDING
  ACTIVE
  FAILED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum OrderStatus {
  OPEN
  IN_KITCHEN
  READY
  CLOSED_PAID
  CLOSED_UNPAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  ON_IT
  PASS
  SERVED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
}

enum PrintJobStatus {
  PENDING
  DISPATCHED
  SENT
  FAILED
}

// Organizations (tenants)
model Organization {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  email    String?
  phone    String?
  address  String?
  logo     String?
  rcNumber String? @map("rc_number")
  tin      String? @map("tin")

  // Paystack integration
  paystackSubaccountCode String? @map("paystack_subaccount_code")
  bankCode               String? @map("bank_code")
  bankAccountNumber      String? @map("bank_account_number")
  bankAccountName        String? @map("bank_account_name")
  settlementBank         String? @map("settlement_bank")
  isPaystackVerified     Boolean @default(false) @map("is_paystack_verified")

  // Bank details shown on the printed pro forma receipt for guests paying by transfer —
  // deliberately separate from the Paystack fields above, which drive actual settlement/payout
  // and shouldn't be conflated with "what account do I read out to a customer."
  receiptBankName          String? @map("receipt_bank_name")
  receiptBankAccountNumber String? @map("receipt_bank_account_number")
  receiptBankAccountName   String? @map("receipt_bank_account_name")

  // Platform settings
  platformFeePercent      Decimal   @default(0.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  invoicePrefix           String    @default("INV") @map("invoice_prefix")
  currency                String    @default("NGN")
  taxRate                 Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  vatEnabled              Boolean   @default(false) @map("vat_enabled")
  // A second, independent tax type (e.g. Nigerian state consumption/entertainment tax on
  // restaurant/bar bills) — stackable with VAT, toggled per order on the Sell screen.
  entertainmentTaxRate    Decimal   @default(0) @map("entertainment_tax_rate") @db.Decimal(5, 2)
  entertainmentTaxEnabled Boolean   @default(false) @map("entertainment_tax_enabled")
  // A gratuity/service fee, not a tax — kept out of taxAmount on the order, added to total
  // separately. Same stackable, per-order-toggleable pattern as entertainment tax.
  serviceChargeRate       Decimal   @default(0) @map("service_charge_rate") @db.Decimal(5, 2)
  serviceChargeEnabled    Boolean   @default(false) @map("service_charge_enabled")
  showQrCode              Boolean   @default(false) @map("show_qr_code")
  paymentTerms            String?   @map("payment_terms")
  defaultNotes            String?   @map("default_notes")
  businessType            String?   @map("business_type")
  organizationSize        String?   @map("organization_size")
  enabledModules          OrgModule @default(INVOICING) @map("enabled_modules")
  onboardingDismissedAt   DateTime? @map("onboarding_dismissed_at")
  clientReminderSentAt    DateTime? @map("client_reminder_sent_at")

  // Google Sheets sync — spreadsheet the org has shared with our service account
  googleSheetId String? @map("google_sheet_id")

  // Bearer token an on-premise print agent uses to poll for/report on print jobs (see
  // PrintAgentGuard). The backend can't reach printers' private LAN IPs directly, so a small
  // local process — running on a machine on the same network as the printers — polls for jobs
  // and does the actual local socket write. Null until an admin generates one from settings;
  // regenerating invalidates whatever agent instance is running with the old value.
  printAgentToken String? @unique @map("print_agent_token")

  // Subscription
  planTier                  PlanTier           @default(FREE) @map("plan_tier")
  subscriptionStatus        SubscriptionStatus @default(TRIALING) @map("subscription_status")
  billingPeriod             BillingPeriod?     @map("billing_period")
  trialStartDate            DateTime?          @map("trial_start_date")
  trialEndDate              DateTime?          @map("trial_end_date")
  subscriptionStartDate     DateTime?          @map("subscription_start_date")
  subscriptionEndDate       DateTime?          @map("subscription_end_date")
  paystackCustomerCode      String?            @map("paystack_customer_code")
  paystackAuthorizationCode String?            @map("paystack_authorization_code")
  paystackBillingEmail      String?            @map("paystack_billing_email")
  paystackCardLast4         String?            @map("paystack_card_last4")
  paystackCardType          String?            @map("paystack_card_type")
  autoRenew                 Boolean            @default(true) @map("auto_renew")
  isGrandfathered           Boolean            @default(false) @map("is_grandfathered")
  // Internal/QA org (e.g. the team's own testing account) — excluded from platform-admin
  // analytics (GMV, org counts, top orgs, etc.) so test data never pollutes real metrics.
  isTestAccount             Boolean            @default(false) @map("is_test_account")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users                User[]
  clients              Client[]
  customers            Customer[]
  invoices             Invoice[]
  payments             Payment[]
  expenses             Expense[]
  expenseCategories    ExpenseCategory[]
  serviceItems         ServiceItem[]
  vendors              Vendor[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  subscriptionPayments SubscriptionPayment[]
  taxReportLogs        TaxReportLog[]
  chatSessions         ChatSession[]
  whatsappMessages     WhatsappMessage[]
  directors            OrganizationDirector[]

  // Restaurant POS
  restaurantTables   RestaurantTable[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  orders             Order[]
  orderTypes         OrderType[]
  paymentTypes       PaymentType[]
  shifts             Shift[]
  idempotencyKeys    IdempotencyKey[]
  walletTransactions WalletTransaction[]
  sheetSyncQueue     SheetSyncQueueEntry[]
  printers           Printer[]

  @@map("organizations")
}

// Users
model User {
  id                  String     @id @default(uuid())
  organizationId      String     @map("organization_id")
  email               String     @unique
  passwordHash        String?    @map("password_hash")
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  // A user can hold more than one role at once (e.g. Cashier + Waiter) — access is the union of
  // whatever each individual role would unlock. Always non-empty; enforced at the service layer
  // since Prisma/Postgres can't express "array must have length >= 1" as a column constraint.
  roles               UserRole[] @default([STAFF])
  businessRole        String?    @map("business_role")
  // Floor-staff contact info — mirrors what the old standalone Waiter directory held before it
  // was merged into User (a WAITER-role account now doubles as the order-attribution record).
  phone               String?
  notes               String?
  isActive            Boolean    @default(true) @map("is_active")
  isEmailVerified     Boolean    @default(false) @map("is_email_verified")
  isPlatformAdmin     Boolean    @default(false) @map("is_platform_admin")
  googleId            String?    @unique @map("google_id")
  // Quick-login PIN for shared POS terminals (waiter/pass/runner/cashier) — set by an admin, not
  // the user's own password. Hashed with bcrypt; lookup is a compare-loop over the org's active
  // PIN-eligible staff since bcrypt hashes aren't directly queryable (fine at realistic org sizes).
  pinHash             String?    @map("pin_hash")
  pinSetAt            DateTime?  @map("pin_set_at")
  // True when `email` is an auto-generated internal placeholder (PIN-eligible roles created
  // without a real email) rather than one the person actually reads — no invite/verification
  // email is ever sent to it, and the UI shouldn't show it as a real address.
  hasPlaceholderEmail Boolean    @default(false) @map("has_placeholder_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdInvoices    Invoice[]                @relation("CreatedByUser")
  recordedPayments   Payment[]                @relation("RecordedByUser")
  recordedExpenses   Expense[]                @relation("RecordedByUser")
  verificationTokens EmailVerificationToken[]
  taxReportLogs      TaxReportLog[]
  chatSessions       ChatSession[]
  createdOrders      Order[]                  @relation("OrderCreatedByUser")
  waiterOrders       Order[]                  @relation("OrderWaiter")
  discountsApplied   Order[]                  @relation("OrderDiscountAppliedBy")
  openedShifts       Shift[]                  @relation("ShiftOpenedByUser")
  closedShifts       Shift[]                  @relation("ShiftClosedByUser")
  walletTransactions WalletTransaction[]

  @@index([organizationId])
  @@map("users")
}

// Email verification and password setup tokens
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Clients (customers of the organization)
model Client {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean @default(true) @map("is_active")
  clientType     String? @default("business") @map("client_type")

  // WhatsApp Business API consent (self-attested by the org, required before API-driven messaging)
  whatsappOptIn   Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt DateTime? @map("whatsapp_opt_in_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  whatsappMessages WhatsappMessage[]

  @@index([organizationId])
  @@map("clients")
}

// Restaurant/POS diner profiles — distinct from Client (invoicing customers)
model Customer {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean @default(true) @map("is_active")
  walletBalance  Decimal @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  // Max the wallet may go negative by (on-account credit). 0 = no credit approved.
  // Only an ADMIN/SUPER_ADMIN can raise this; any role can then spend against it.
  creditLimit    Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders             Order[]
  walletTransactions WalletTransaction[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("customers")
}

// Restaurant/POS floor staff roster — lightweight, no login required
// Append-only ledger backing Customer.walletBalance — every credit/debit is a row here, timestamped
// and user-attributed, so the cached balance can always be reconstructed and audited.
model WalletTransaction {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  customerId     String                @map("customer_id")
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(12, 2)
  balanceBefore  Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(12, 2)
  orderId        String?               @map("order_id")
  paymentId      String?               @map("payment_id")
  createdById    String                @map("created_by")
  reference      String?
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([orderId])
  @@map("wallet_transactions")
}

enum SheetSyncTab {
  ORDER_ITEMS
  WALLET_TRANSACTIONS
}

// Outbox for the Google Sheets sync: rows are queued here in the same transaction as the
// business mutation they describe, then flushed to the org's spreadsheet by a background job —
// so a Sheets API outage never loses data and never blocks the request path.
model SheetSyncQueueEntry {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  tab            SheetSyncTab
  rowValues      Json         @map("row_values")
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  syncedAt       DateTime?    @map("synced_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, syncedAt])
  @@map("sheet_sync_queue")
}

// CAC-registered directors (CAMA 2020 s.304 compliance) — shown on invoices, no app login required
model OrganizationDirector {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  forenames     String
  surname       String
  formerName    String? @map("former_name")
  isNonNigerian Boolean @default(false) @map("is_non_nigerian")
  nationality   String?
  sortOrder     Int     @default(0) @map("sort_order")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_directors")
}

// Invoices
model Invoice {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  clientId       String @map("client_id")
  createdById    String @map("created_by")

  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date

  subtotal        Decimal @db.Decimal(12, 2)
  discountType    String  @default("PERCENTAGE") @map("discount_type")
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)
  amountPaid      Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)

  notes String?
  terms String?

  // Paystack payment link
  paystackReference        String?   @unique @map("paystack_reference")
  paystackAccessCode       String?   @map("paystack_access_code")
  paymentUrl               String?   @map("payment_url")
  paystackTokenGeneratedAt DateTime? @map("paystack_token_generated_at")
  paystackPaidAt           DateTime? @map("paystack_paid_at")
  paystackChannel          String?   @map("paystack_channel")

  // Attached image (e.g. signed document, proof of work)
  imageUrl String? @map("image_url")

  // Public sharing
  shareToken String? @unique @map("share_token")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client               @relation(fields: [clientId], references: [id])
  createdBy        User                 @relation("CreatedByUser", fields: [createdById], references: [id])
  items            InvoiceItem[]
  payments         Payment[]
  installments     PaymentInstallment[]
  whatsappMessages WhatsappMessage[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

// Payment installments for staged payments
model PaymentInstallment {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  label      String // e.g., "First Payment", "Final Payment"
  sequence   Int // Order of installment (1, 2, 3...)
  percentage Decimal? @db.Decimal(5, 2) // If percentage-based
  amount     Decimal  @db.Decimal(12, 2) // Calculated or fixed amount

  // Payment status
  isPaid Boolean   @default(false) @map("is_paid")
  paidAt DateTime? @map("paid_at")

  // Paystack payment link for this installment
  paystackReference        String?   @unique @map("paystack_reference")
  paystackAccessCode       String?   @map("paystack_access_code")
  paymentUrl               String?   @map("payment_url")
  paystackTokenGeneratedAt DateTime? @map("paystack_token_generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment_installments")
}

// Invoice line items
model InvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String  @map("invoice_id")
  serviceItemId   String? @map("service_item_id")
  inventoryItemId String? @map("inventory_item_id")
  description     String
  quantity        Decimal @db.Decimal(10, 2)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem?   @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceItemId])
  @@index([inventoryItemId])
  @@map("invoice_items")
}

// Payments
model Payment {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  invoiceId      String? @map("invoice_id")
  orderId        String? @map("order_id")
  recordedById   String? @map("recorded_by")

  amount        Decimal  @db.Decimal(12, 2)
  // Name of a PaymentType for this org (e.g. "Cash", "Bank Transfer", or a custom one), or the
  // reserved literal "PAYSTACK"/"WALLET" — those two are hardcoded/code-tied, never part of the
  // per-org PaymentType list. Deliberately a plain string, not the PaymentMethod enum (which
  // Expense.paymentMethod still uses) — see PaymentType below.
  paymentMethod String   @map("payment_method")
  paymentDate   DateTime @map("payment_date") @db.Date
  reference     String?
  notes         String?

  // Auto-recorded via webhook
  isAutoRecorded    Boolean  @default(false) @map("is_auto_recorded")
  paystackReference String?  @map("paystack_reference")
  paystackFees      Decimal? @map("paystack_fees") @db.Decimal(12, 2)
  platformFees      Decimal? @map("platform_fees") @db.Decimal(12, 2)
  netAmount         Decimal? @map("net_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  recordedBy         User?               @relation("RecordedByUser", fields: [recordedById], references: [id])
  walletTransactions WalletTransaction[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([orderId])
  @@map("payments")
}

// Expense categories
model ExpenseCategory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

// Expenses
model Expense {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  categoryId     String? @map("category_id")
  vendorId       String? @map("vendor_id")
  recordedById   String  @map("recorded_by")

  description   String
  amount        Decimal       @db.Decimal(12, 2)
  expenseDate   DateTime      @map("expense_date") @db.Date
  recipient     String?
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?
  notes         String?
  taxCategory   TaxCategory   @default(UNCATEGORIZED) @map("tax_category")
  isDeductible  Boolean       @default(true) @map("is_deductible")

  // Auto-recorded via vendor payout webhook
  isAutoRecorded    Boolean  @default(false) @map("is_auto_recorded")
  paystackReference String?  @unique @map("paystack_reference")
  paystackFees      Decimal? @map("paystack_fees") @db.Decimal(12, 2)
  netAmount         Decimal? @map("net_amount") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  vendor       Vendor?          @relation(fields: [vendorId], references: [id])
  recordedBy   User             @relation("RecordedByUser", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([expenseDate])
  @@map("expenses")
}

// Service items (predefined products/services for invoices)
model ServiceItem {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_items")
}

// Inventory items (physical goods with stock tracking)
model InventoryItem {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  name             String
  description      String?
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  onHandQuantity   Decimal @default(0) @map("on_hand_quantity") @db.Decimal(10, 2)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(10, 2)
  reorderLevel     Decimal @default(0) @map("reorder_level") @db.Decimal(10, 2)
  sku              String?
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]
  menuItems      MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inventory_items")
}

// Stock movement log
model StockMovement {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  inventoryItemId String            @map("inventory_item_id")
  invoiceId       String?           @map("invoice_id")
  orderId         String?           @map("order_id")
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 2)
  onHandBefore    Decimal           @map("on_hand_before") @db.Decimal(10, 2)
  onHandAfter     Decimal           @map("on_hand_after") @db.Decimal(10, 2)
  notes           String?
  createdById     String?           @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([orderId])
  @@map("stock_movements")
}

// Vendors (external service providers/suppliers)
model Vendor {
  id                 String  @id @default(uuid())
  organizationId     String  @map("organization_id")
  name               String
  serviceDescription String? @map("service_description")
  contactPerson      String? @map("contact_person")
  phone              String?
  email              String?
  bankAccountNumber  String? @map("bank_account_number")
  bankName           String? @map("bank_name")
  isActive           Boolean @default(true) @map("is_active")

  // Paystack payout integration
  bankCode                 String?                   @map("bank_code")
  isBankVerified           Boolean                   @default(false) @map("is_bank_verified")
  paystackSubaccountCode   String?                   @map("paystack_subaccount_code")
  paystackSubaccountStatus PaystackSubaccountStatus? @map("paystack_subaccount_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("vendors")
}

// Subscription payments (separate from invoice payments)
model SubscriptionPayment {
  id                String        @id @default(uuid())
  organizationId    String        @map("organization_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  billingPeriod     BillingPeriod @map("billing_period")
  planTier          PlanTier      @map("plan_tier")
  paystackReference String        @unique @map("paystack_reference")
  status            String        @default("success")
  paidAt            DateTime      @map("paid_at")
  periodStart       DateTime      @map("period_start")
  periodEnd         DateTime      @map("period_end")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("subscription_payments")
}

// Tax report generation audit log
model TaxReportLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  generatedAt    DateTime @default(now()) @map("generated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_report_logs")
}

// Shortened links mapping table
model ShortLink {
  id        String    @id @default(uuid())
  slug      String    @unique
  targetUrl String    @map("target_url")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@map("short_links")
}

model ChatSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  title          String
  isPinned       Boolean   @default(false) @map("is_pinned")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([organizationId, userId])
  @@index([deletedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String // "user" | "assistant"
  content   String
  layout    Json? // Optional JSON layout representing dynamic UI components
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// Outbound WhatsApp Business API messages (invoice reminders, etc.)
model WhatsappMessage {
  id                String                @id @default(uuid())
  organizationId    String                @map("organization_id")
  invoiceId         String?               @map("invoice_id")
  clientId          String?               @map("client_id")
  templateName      String                @map("template_name")
  toPhone           String                @map("to_phone")
  status            WhatsappMessageStatus @default(PENDING)
  providerMessageId String?               @unique @map("provider_message_id")
  errorMessage      String?               @map("error_message")
  errorCode         String?               @map("error_code")
  sentAt            DateTime?             @map("sent_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("whatsapp_messages")
}

// ─── Restaurant POS ─────────────────────────────────────────────────────────

model RestaurantTable {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  name           String
  section        String?
  capacity       Int         @default(2)
  status         TableStatus @default(AVAILABLE)
  isActive       Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("restaurant_tables")
}

model MenuCategory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems    MenuItemCategory[]
  printers     MenuCategoryPrinter[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_categories")
}

// Per-org order types (e.g. Dine In, Takeaway, or something org-specific like "Hotel Room
// Service" for a restaurant with an attached hotel). Order.source stores this row's `name`
// directly as a plain string — no separate translation layer, same as Printer.station.
model OrderType {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")
  // Whether an order placed under this type requires a table (occupies it, frees it when the
  // order moves off this type) — generalizes what used to be a hardcoded `source === 'DINE_IN'` check.
  requiresTable  Boolean @default(false) @map("requires_table")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("order_types")
}

// Per-org payment methods (e.g. Cash, Bank Transfer, Card, or something org-specific like "POS
// Terminal - GTBank"). PAYSTACK and WALLET are NOT managed here — they're hardcoded, code-tied
// (checkout flow / wallet debit) and always available regardless of this list.
model PaymentType {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  sortOrder      Int     @default(0) @map("sort_order")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("payment_types")
}

model MenuItem {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  inventoryItemId String? @map("inventory_item_id")
  name            String
  description     String?
  price           Decimal @db.Decimal(12, 2)
  imageUrl        String? @map("image_url")
  isAvailable     Boolean @default(true) @map("is_available")
  // Expected kitchen prep time in minutes; drives the countdown timer on the kitchen ticket board. Optional — items without one are excluded from that calculation.
  durationMinutes Int?    @map("duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  categories    MenuItemCategory[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_items")
}

model MenuItemCategory {
  menuItemId String @map("menu_item_id")
  categoryId String @map("category_id")

  createdAt DateTime @default(now()) @map("created_at")

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([menuItemId, categoryId])
  @@index([categoryId])
  @@map("menu_item_categories")
}

// A physical thermal printer (Kitchen, Bar, etc.) that dockets get routed to.
// `station` is a freeform label set by the org rather than a fixed enum, since
// orgs may run more than the usual Kitchen/Bar split (e.g. a dessert or expo station).
model Printer {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  name           String
  station        String
  connectionType PrinterConnectionType @default(NETWORK) @map("connection_type")
  ipAddress      String?               @map("ip_address")
  port           Int?                  @default(9100)
  // For USB/BLUETOOTH printers, which have no network address — the Windows share name the
  // print agent sends raw bytes to (e.g. an XP-80C shared as "XP80C", reached by the agent as
  // \\localhost\XP80C since it runs on the same machine the printer is plugged into).
  devicePath     String?               @map("device_path")
  isActive       Boolean               @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   MenuCategoryPrinter[]
  printJobs    PrintJob[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("printers")
}

// Which printer(s) a menu category's items should be docketed to. A category with no
// rows here routes to every active printer for the org (broadcast-to-all default).
model MenuCategoryPrinter {
  categoryId String @map("category_id")
  printerId  String @map("printer_id")

  createdAt DateTime @default(now()) @map("created_at")

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  printer  Printer      @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@id([categoryId, printerId])
  @@index([printerId])
  @@map("menu_category_printers")
}

// One row per (order, printer) docket dispatch, so a printer being offline never blocks
// the others and staff can see/reprint failures from the order screen.
model PrintJob {
  id        String         @id @default(uuid())
  orderId   String         @map("order_id")
  printerId String         @map("printer_id")
  status    PrintJobStatus @default(PENDING)
  payload   Json
  error     String?
  attempts  Int            @default(0)
  printedAt DateTime?      @map("printed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([printerId])
  @@index([status])
  @@map("print_jobs")
}

model Order {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  tableId        String?     @map("table_id")
  customerId     String?     @map("customer_id")
  waiterId       String?     @map("waiter_id")
  createdById    String      @map("created_by")
  // The OrderType.name this order was placed under (e.g. "Dine In", "Hotel Room Service") —
  // a plain string, not an enum, since order types are org-configurable. See OrderType above.
  source         String      @default("Dine In")
  status         OrderStatus @default(OPEN)

  subtotal   Decimal @db.Decimal(12, 2)
  // taxAmount is always vatAmount + entertainmentTaxAmount — kept as the single source everything
  // else (receipts, close/payment, reports) already reads for the order total. serviceChargeAmount
  // is added on top separately since it's a fee, not a tax.
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)
  notes      String?

  // Per-order tax breakdown — decided once at order creation (not re-derived from the org's
  // current settings on every read) so a later settings change never retroactively alters an
  // already-placed order's charges.
  vatApplied              Boolean @default(false) @map("vat_applied")
  entertainmentTaxApplied Boolean @default(false) @map("entertainment_tax_applied")
  serviceChargeApplied    Boolean @default(false) @map("service_charge_applied")
  vatAmount               Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  entertainmentTaxAmount  Decimal @default(0) @map("entertainment_tax_amount") @db.Decimal(12, 2)
  serviceChargeAmount     Decimal @default(0) @map("service_charge_amount") @db.Decimal(12, 2)

  // Applied at payment time (see OrdersService.applyDiscount), not at order creation — mirrors
  // the Invoice discount pattern (pre-tax: subtotal - discountAmount, then tax/service charge
  // computed on the remainder). Restricted to oversight roles; reason + who is required for audit,
  // since an unrestricted till-side discount is a fraud vector.
  discountType        String  @default("PERCENTAGE") @map("discount_type")
  discountPercent     Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason      String? @map("discount_reason")
  discountAppliedById String? @map("discount_applied_by")
  discountAppliedBy   User?   @relation("OrderDiscountAppliedBy", fields: [discountAppliedById], references: [id], onDelete: SetNull)

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table              RestaurantTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  waiter             User?               @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("OrderCreatedByUser", fields: [createdById], references: [id])
  items              OrderItem[]
  payments           Payment[]
  stockMovements     StockMovement[]
  walletTransactions WalletTransaction[]
  printJobs          PrintJob[]

  @@index([organizationId])
  @@index([tableId])
  @@index([customerId])
  @@index([waiterId])
  @@index([status])
  @@map("orders")
}

model Shift {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  openedById     String      @map("opened_by")
  closedById     String?     @map("closed_by")
  status         ShiftStatus @default(OPEN)

  openingFloat Decimal  @default(0) @map("opening_float") @db.Decimal(12, 2)
  expectedCash Decimal? @map("expected_cash") @db.Decimal(12, 2)
  countedCash  Decimal? @map("counted_cash") @db.Decimal(12, 2)
  variance     Decimal? @db.Decimal(12, 2)
  notes        String?

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedBy     User         @relation("ShiftOpenedByUser", fields: [openedById], references: [id])
  closedBy     User?        @relation("ShiftClosedByUser", fields: [closedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@map("shifts")
}

// Generic idempotency guard for client-retried POS mutations (offline queue flush, double-tap,
// etc.) — one table for any action type rather than a bespoke unique column per mutation.
model IdempotencyKey {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  action         String
  key            String
  resultSnapshot Json?    @map("result_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, action, key])
  @@index([organizationId])
  @@map("idempotency_keys")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String          @map("order_id")
  menuItemId String?         @map("menu_item_id")
  itemName   String          @map("item_name")
  quantity   Decimal         @db.Decimal(10, 2)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(12, 2)
  amount     Decimal         @db.Decimal(12, 2)
  notes      String?
  status     OrderItemStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // itemName is a point-in-time snapshot so order history/receipts still show what was
  // ordered after the menu item itself is hard-deleted; menuItem may be null once that happens.
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}
