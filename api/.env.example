# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tari1?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxx"
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment/callback"

# App
PORT=3000
# IMPORTANT: Set NODE_ENV=production in all live/staging environments.
# When set to "development", the /paystack/simulate-success endpoint is enabled for local testing.
NODE_ENV=development

# Platform Fee (percentage)
PLATFORM_FEE_PERCENT=5

# CORS (comma-separated list of allowed origins for production)
# CORS_ORIGINS=https://app.tari1.app,https://www.tari1.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Resend / Email Settings
RESEND_API_KEY=re_xxxx
# Product name is Tari1. Domain is tarione.com.
RESEND_FROM_EMAIL="Tari1 <noreply@tarione.com>"
FRONTEND_URL="http://localhost:5173"
BRAND_WEBSITE_URL="https://www.tarione.com"

# DeepSeek (AI insights & chat)
DEEPSEEK_API_KEY=sk-xxxx
